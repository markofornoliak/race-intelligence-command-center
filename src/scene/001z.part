{
  // RI–05 enhancement layer: sculpted bodywork, detailed wheels and richer lighting.
  renderer.toneMappingExposure = 1.2;
  camera.position.set(11.45, 4.35, 15.55);
  world.position.set(0.9, -0.12, 0);
  car.scale.setScalar(0.92);

  const ri05Key = new THREE.DirectionalLight(0xd8f6ff, 1.15);
  ri05Key.position.set(-8, 7, 4);
  scene.add(ri05Key);

  const ri05CockpitLight = new THREE.PointLight(0x5ee5ff, 2.6, 8, 2);
  ri05CockpitLight.position.set(0.15, 1.4, 0);
  scene.add(ri05CockpitLight);

  const ri05RearGlow = new THREE.PointLight(0xff2638, 3.2, 7, 2);
  ri05RearGlow.position.set(4.1, 0.55, 0);
  scene.add(ri05RearGlow);

  const ri05Palette = {
    carbon: 0x020509,
    graphite: 0x111a21,
    body: 0x061f31,
    bodyLight: 0x0a3854,
    cyan: 0x63dcff,
    ice: 0xd4f5ff,
    red: 0xff2939,
    silver: 0x9eb9c8
  };

  const ri05Material = ({
    category = 'systems',
    color = ri05Palette.body,
    opacity = 0.78,
    metalness = 0.58,
    roughness = 0.25,
    clearcoat = 0.86,
    emissive = 0x031522,
    emissiveIntensity = 0.42
  } = {}) => {
    const material = new THREE.MeshPhysicalMaterial({
      color,
      metalness,
      roughness,
      clearcoat,
      clearcoatRoughness: 0.17,
      transparent: true,
      opacity,
      depthWrite: opacity > 0.78,
      side: THREE.DoubleSide,
      emissive,
      emissiveIntensity
    });
    material.userData.baseOpacity = opacity;
    return material;
  };

  const ri05AddPart = (geometry, options = {}) => {
    const {
      parent = car,
      position = [0, 0, 0],
      rotation = [0, 0, 0],
      scale = [1, 1, 1],
      category = 'systems',
      color = ri05Palette.body,
      opacity = category === 'aero' ? 0.32 : 0.78,
      edgeOpacity = category === 'aero' ? 0.86 : 0.62,
      metalness = 0.58,
      roughness = 0.25,
      clearcoat = 0.86,
      emissive = category === 'signal' ? 0x063348 : 0x031522,
      emissiveIntensity = category === 'signal' ? 0.95 : 0.42,
      edgeColor = null
    } = options;

    const group = new THREE.Group();
    group.position.set(...position);
    group.rotation.set(...rotation);
    group.scale.set(...scale);
    parent.add(group);

    const surface = new THREE.Mesh(geometry, ri05Material({
      category,
      color,
      opacity,
      metalness,
      roughness,
      clearcoat,
      emissive,
      emissiveIntensity
    }));
    surface.renderOrder = 1;
    group.add(surface);

    const edges = new THREE.LineSegments(
      new THREE.EdgesGeometry(geometry, 26),
      lineMaterial(category, edgeOpacity)
    );
    if (edgeColor !== null) edges.material.color.setHex(edgeColor);
    edges.renderOrder = 4;
    group.add(edges);

    register(group, category);
    return group;
  };

  const ri05Loft = (sections, radialSegments = 16) => {
    const positions = [];
    const indices = [];

    sections.forEach((section) => {
      const {
        x,
        y = 0,
        z = 0,
        radiusY,
        radiusZ,
        pinch = 1.08,
        twist = 0
      } = section;

      for (let segment = 0; segment < radialSegments; segment += 1) {
        const angle = (segment / radialSegments) * Math.PI * 2 + twist;
        const cosine = Math.cos(angle);
        const sine = Math.sin(angle);
        positions.push(
          x,
          y + Math.sign(cosine) * Math.pow(Math.abs(cosine), pinch) * radiusY,
          z + Math.sign(sine) * Math.pow(Math.abs(sine), pinch) * radiusZ
        );
      }
    });

    for (let ring = 0; ring < sections.length - 1; ring += 1) {
      for (let segment = 0; segment < radialSegments; segment += 1) {
        const next = (segment + 1) % radialSegments;
        const a = ring * radialSegments + segment;
        const b = ring * radialSegments + next;
        const c = (ring + 1) * radialSegments + segment;
        const d = (ring + 1) * radialSegments + next;
        indices.push(a, c, b, b, c, d);
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();
    return geometry;
  };

  const ri05Tube = (points, radius, options = {}) => {
    const curve = new THREE.CatmullRomCurve3(points.map((point) => new THREE.Vector3(...point)));
    return ri05AddPart(
      new THREE.TubeGeometry(curve, options.tubularSegments ?? 56, radius, options.radialSegments ?? 10, false),
      options
    );
  };

  const ri05Wing = (position, scale, rotation = [0, 0, 0], options = {}) => ri05AddPart(
    new THREE.BoxGeometry(1, 1, 1, 8, 2, 8),
    {
      position,
      scale,
      rotation,
      category: 'aero',
      color: options.color ?? 0x082a40,
      opacity: options.opacity ?? 0.42,
      edgeOpacity: options.edgeOpacity ?? 0.92,
      metalness: 0.64,
      roughness: 0.19,
      clearcoat: 0.92
    }
  );

  ri05AddPart(ri05Loft([
    { x: -5.35, y: -0.09, radiusY: 0.1, radiusZ: 0.1, pinch: 1.4 },
    { x: -4.72, y: -0.05, radiusY: 0.17, radiusZ: 0.21, pinch: 1.28 },
    { x: -3.8, y: 0.0, radiusY: 0.27, radiusZ: 0.34, pinch: 1.2 },
    { x: -2.72, y: 0.08, radiusY: 0.38, radiusZ: 0.48, pinch: 1.16 },
    { x: -1.62, y: 0.22, radiusY: 0.52, radiusZ: 0.64, pinch: 1.12 },
    { x: -0.55, y: 0.39, radiusY: 0.64, radiusZ: 0.74, pinch: 1.08 },
    { x: 0.38, y: 0.42, radiusY: 0.68, radiusZ: 0.78, pinch: 1.08 },
    { x: 1.36, y: 0.3, radiusY: 0.56, radiusZ: 0.7, pinch: 1.1 },
    { x: 2.45, y: 0.16, radiusY: 0.4, radiusZ: 0.56, pinch: 1.15 },
    { x: 3.55, y: 0.12, radiusY: 0.29, radiusZ: 0.4, pinch: 1.2 },
    { x: 4.35, y: 0.18, radiusY: 0.19, radiusZ: 0.23, pinch: 1.28 }
  ], 18), {
    color: ri05Palette.body,
    opacity: 0.72,
    edgeOpacity: 0.82,
    emissive: 0x041b2a,
    emissiveIntensity: 0.58
  });

  ri05AddPart(new THREE.BoxGeometry(8.35, 0.095, 3.15, 20, 1, 10), {
    position: [0.28, -0.79, 0],
    color: ri05Palette.carbon,
    opacity: 0.96,
    edgeOpacity: 0.46,
    metalness: 0.72,
    roughness: 0.34,
    clearcoat: 0.46
  });

  ri05AddPart(wedgeGeometry(6.9, 0.14, 2.7, 3.04), {
    position: [0.9, -0.67, 0],
    category: 'aero',
    color: 0x061827,
    opacity: 0.48,
    edgeOpacity: 0.66
  });

  [-1, 1].forEach((side) => {
    ri05AddPart(ri05Loft([
      { x: -0.9, y: 0.02, z: side * 0.82, radiusY: 0.22, radiusZ: 0.2, pinch: 1.3 },
      { x: -0.15, y: 0.06, z: side * 1.04, radiusY: 0.38, radiusZ: 0.34, pinch: 1.18 },
      { x: 0.85, y: 0.06, z: side * 1.12, radiusY: 0.49, radiusZ: 0.4, pinch: 1.12 },
      { x: 1.85, y: 0.02, z: side * 1.02, radiusY: 0.42, radiusZ: 0.34, pinch: 1.14 },
      { x: 2.85, y: -0.02, z: side * 0.8, radiusY: 0.28, radiusZ: 0.22, pinch: 1.2 },
      { x: 3.55, y: 0.0, z: side * 0.61, radiusY: 0.18, radiusZ: 0.13, pinch: 1.28 }
    ], 14), {
      color: ri05Palette.bodyLight,
      opacity: 0.68,
      edgeOpacity: 0.74,
      emissive: 0x031725,
      emissiveIntensity: 0.46
    });

    ri05AddPart(new THREE.TorusGeometry(0.27, 0.06, 10, 30, Math.PI * 1.35), {
      position: [-0.22, 0.27, side * 1.18],
      rotation: [Math.PI / 2, 0, side > 0 ? Math.PI * 0.16 : -Math.PI * 0.16],
      category: 'aero',
      color: ri05Palette.carbon,
      opacity: 0.92,
      edgeOpacity: 0.74
    });

    ri05Tube([
      [-0.8, -0.34, side * 1.14],
      [0.1, -0.47, side * 1.34],
      [1.35, -0.49, side * 1.28],
      [2.55, -0.42, side * 1.03],
      [3.62, -0.3, side * 0.7]
    ], 0.034, {
      category: 'aero',
      color: 0x0a3048,
      opacity: 0.62,
      edgeOpacity: 0.84
    });
  });

  ri05AddPart(ri05Loft([
    { x: 0.42, y: 0.72, radiusY: 0.37, radiusZ: 0.48, pinch: 1.16 },
    { x: 1.1, y: 0.82, radiusY: 0.44, radiusZ: 0.46, pinch: 1.12 },
    { x: 2.0, y: 0.75, radiusY: 0.42, radiusZ: 0.4, pinch: 1.14 },
    { x: 3.0, y: 0.58, radiusY: 0.32, radiusZ: 0.3, pinch: 1.18 },
    { x: 3.94, y: 0.42, radiusY: 0.2, radiusZ: 0.18, pinch: 1.24 }
  ], 14), {
    color: 0x061d2d,
    opacity: 0.76,
    edgeOpacity: 0.78
  });

  ri05AddPart(wedgeGeometry(2.74, 1.0, 0.07, 0.13), {
    position: [2.38, 1.0, 0],
    rotation: [0, 0, -0.12],
    category: 'aero',
    color: 0x08273b,
    opacity: 0.42,
    edgeOpacity: 0.82
  });

  ri05AddPart(new THREE.CapsuleGeometry(0.48, 1.08, 8, 20), {
    position: [-0.16, 0.78, 0],
    rotation: [0, 0, Math.PI / 2],
    scale: [1, 0.72, 0.93],
    color: ri05Palette.carbon,
    opacity: 0.97,
    edgeOpacity: 0.42,
    metalness: 0.4,
    roughness: 0.5
  });

  ri05AddPart(new THREE.SphereGeometry(0.33, 26, 18), {
    position: [0.02, 1.08, 0],
    scale: [1, 0.9, 0.9],
    color: 0xd4f2ff,
    opacity: 0.7,
    edgeOpacity: 0.66,
    metalness: 0.38,
    roughness: 0.18,
    clearcoat: 0.96,
    emissive: 0x0b354a,
    emissiveIntensity: 0.56
  });

  ri05Tube([
    [-0.75, 0.71, -0.52],
    [-0.44, 1.22, -0.65],
    [0.12, 1.45, 0],
    [-0.44, 1.22, 0.65],
    [-0.75, 0.71, 0.52]
  ], 0.064, {
    color: ri05Palette.carbon,
    opacity: 0.98,
    edgeOpacity: 0.88,
    tubularSegments: 64,
    radialSegments: 12
  });
  makeStrut([0.12, 1.45, 0], [0.32, 0.7, 0], 0.056, 'systems', 0.9);

  ri05AddPart(new THREE.TorusGeometry(0.27, 0.062, 12, 32), {
    position: [0.9, 1.32, 0],
    rotation: [Math.PI / 2, 0, 0],
    scale: [1, 1.22, 1],
    color: ri05Palette.carbon,
    opacity: 0.95,
    edgeOpacity: 0.72
  });

  ri05AddPart(new THREE.BoxGeometry(0.28, 0.11, 0.16, 3, 2, 2), {
    position: [-0.93, 1.08, 0],
    color: ri05Palette.red,
    opacity: 0.92,
    edgeOpacity: 0.8,
    emissive: 0x480408,
    emissiveIntensity: 0.8
  });

  [
    { x: -5.3, y: -0.48, sx: 1.24, sy: 0.052, sz: 3.46, rz: -0.02 },
    { x: -5.06, y: -0.27, sx: 0.98, sy: 0.047, sz: 3.16, rz: -0.08 },
    { x: -4.82, y: -0.08, sx: 0.75, sy: 0.043, sz: 2.8, rz: -0.14 },
    { x: -4.59, y: 0.08, sx: 0.5, sy: 0.038, sz: 2.36, rz: -0.2 }
  ].forEach((blade) => {
    ri05Wing([blade.x, blade.y, 0], [blade.sx, blade.sy, blade.sz], [0, 0, blade.rz], {
      opacity: 0.48,
      edgeOpacity: 0.96
    });
  });

  ri05Wing([-5.22, -0.12, -1.82], [0.68, 0.72, 0.052], [0, 0, -0.04], { opacity: 0.66 });
  ri05Wing([-5.22, -0.12, 1.82], [0.68, 0.72, 0.052], [0, 0, -0.04], { opacity: 0.66 });

  ri05Wing([4.7, 1.36, 0], [0.92, 0.085, 2.88], [0, 0, 0.035], { opacity: 0.6 });
  ri05Wing([4.5, 1.1, 0], [0.68, 0.06, 2.52], [0, 0, -0.055], { opacity: 0.5 });
  ri05Wing([4.52, 0.44, 0], [0.7, 0.052, 2.2], [0, 0, 0.12], { opacity: 0.42 });
  ri05Wing([4.88, 1.02, -1.48], [0.16, 1.05, 0.052], [0, 0, 0.03], { opacity: 0.7 });
  ri05Wing([4.88, 1.02, 1.48], [0.16, 1.05, 0.052], [0, 0, 0.03], { opacity: 0.7 });
  makeStrut([4.18, 0.3, -0.36], [4.55, 1.26, -0.36], 0.047, 'aero', 0.9);
  makeStrut([4.18, 0.3, 0.36], [4.55, 1.26, 0.36], 0.047, 'aero', 0.9);
  makeStrut([4.45, 0.92, 0], [4.62, 1.28, 0], 0.042, 'aero', 0.9);

  [-1.05, -0.62, -0.2, 0.2, 0.62, 1.05].forEach((z) => {
    ri05AddPart(wedgeGeometry(1.78, 0.32, 0.055, 0.085), {
      position: [3.84, -0.52, z],
      rotation: [0, 0, 0.1],
      category: 'aero',
      color: 0x061b29,
      opacity: 0.5,
      edgeOpacity: 0.78
    });
  });

  const ri05WheelSpecs = [
    { x: -3.18, z: -1.76, radius: 0.79, width: 0.54, front: true },
    { x: -3.18, z: 1.76, radius: 0.79, width: 0.54, front: true },
    { x: 3.22, z: -1.85, radius: 0.88, width: 0.64, front: false },
    { x: 3.22, z: 1.85, radius: 0.88, width: 0.64, front: false }
  ];

  ri05WheelSpecs.forEach(({ x, z, radius, width, front }) => {
    const wheel = new THREE.Group();
    wheel.position.set(x, -0.54, z);
    car.add(wheel);

    const tireMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x010306,
      metalness: 0.04,
      roughness: 0.7,
      clearcoat: 0.24,
      transparent: true,
      opacity: 0.98
    });
    tireMaterial.userData.baseOpacity = 0.98;
    const tire = new THREE.Mesh(
      new THREE.CylinderGeometry(radius, radius, width, 52, 3, false),
      tireMaterial
    );
    tire.rotation.x = Math.PI / 2;
    wheel.add(tire);

    const rimMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x111a21,
      metalness: 0.92,
      roughness: 0.18,
      clearcoat: 0.52,
      transparent: true,
      opacity: 0.98
    });
    rimMaterial.userData.baseOpacity = 0.98;
    const rim = new THREE.Mesh(
      new THREE.CylinderGeometry(radius * 0.54, radius * 0.54, width * 1.04, 34, 2, false),
      rimMaterial
    );
    rim.rotation.x = Math.PI / 2;
    wheel.add(rim);

    const discMaterial = new THREE.MeshStandardMaterial({
      color: 0x4c5962,
      metalness: 0.9,
      roughness: 0.34,
      emissive: 0x210303,
      emissiveIntensity: 0.24,
      transparent: true,
      opacity: 0.9
    });
    discMaterial.userData.baseOpacity = 0.9;
    const disc = new THREE.Mesh(
      new THREE.CylinderGeometry(radius * 0.39, radius * 0.39, width * 0.26, 38, 1, false),
      discMaterial
    );
    disc.rotation.x = Math.PI / 2;
    wheel.add(disc);

    const caliperMaterial = new THREE.MeshStandardMaterial({
      color: ri05Palette.red,
      metalness: 0.65,
      roughness: 0.25,
      emissive: 0x3b0306,
      emissiveIntensity: 0.54,
      transparent: true,
      opacity: 0.96
    });
    caliperMaterial.userData.baseOpacity = 0.96;
    const caliper = new THREE.Mesh(
      new THREE.BoxGeometry(0.13, radius * 0.44, 0.12, 2, 6, 2),
      caliperMaterial
    );
    caliper.position.set(0.04, 0, width * 0.18);
    wheel.add(caliper);

    [-1, 1].forEach((face) => {
      const ringMaterial = new THREE.MeshBasicMaterial({
        color: front ? 0x7fe4ff : 0xff3041,
        transparent: true,
        opacity: 0.68,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });
      ringMaterial.userData.baseOpacity = 0.68;
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius * 0.77, 0.014, 8, 56),
        ringMaterial
      );
      ring.position.z = face * width * 0.51;
      wheel.add(ring);
    });

    for (let index = 0; index < 12; index += 1) {
      const angle = (index / 12) * Math.PI * 2;
      const spoke = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(0, Math.cos(angle) * radius * 0.14, Math.sin(angle) * radius * 0.14),
          new THREE.Vector3(0, Math.cos(angle + 0.16) * radius * 0.49, Math.sin(angle + 0.16) * radius * 0.49)
        ]),
        lineMaterial('systems', 0.68)
      );
      spoke.rotation.y = Math.PI / 2;
      wheel.add(spoke);
    }

    register(wheel, 'systems');
  });

  const ri05Shadow = new THREE.Mesh(
    new THREE.CircleGeometry(6.8, 84),
    new THREE.MeshBasicMaterial({
      color: 0x050d14,
      transparent: true,
      opacity: 0.42,
      depthWrite: false
    })
  );
  ri05Shadow.rotation.x = -Math.PI / 2;
  ri05Shadow.scale.set(1.55, 0.52, 1);
  ri05Shadow.position.set(0.6, -1.18, 0);
  scene.add(ri05Shadow);

  const ri05UnderGlow = new THREE.Mesh(
    new THREE.PlaneGeometry(8.6, 3.5),
    new THREE.MeshBasicMaterial({
      color: 0x1e94d2,
      transparent: true,
      opacity: 0.035,
      side: THREE.DoubleSide,
      depthWrite: false,
      blending: THREE.AdditiveBlending
    })
  );
  ri05UnderGlow.rotation.x = -Math.PI / 2;
  ri05UnderGlow.position.set(0.4, -1.13, 0);
  scene.add(ri05UnderGlow);

  const modelReadout = document.querySelector('.scene-readout div:first-child strong');
  if (modelReadout) modelReadout.textContent = 'RI–05';
}
