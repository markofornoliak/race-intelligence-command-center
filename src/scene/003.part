    ], lane * 0.13);
  }

  const signalCurves = [];
  const addSignalCurve = (points) => {
    const curve = new THREE.CatmullRomCurve3(points);
    const line = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(curve.getPoints(100)),
      lineMaterial('signal', 0.54)
    );
    world.add(line);
    register(line, 'signal');
    signalCurves.push(curve);
  };

  addSignalCurve([
    new THREE.Vector3(-5.1, -0.1, 0),
    new THREE.Vector3(-3.1, 0.15, 0),
    new THREE.Vector3(-0.2, 0.72, 0),
    new THREE.Vector3(2.15, 0.45, 0),
    new THREE.Vector3(4.7, 1.08, 0)
  ]);
  addSignalCurve([
    new THREE.Vector3(-2.92, -0.55, -1.75),
    new THREE.Vector3(-1.6, 0.1, -0.7),
    new THREE.Vector3(0.1, 0.6, 0),
    new THREE.Vector3(2.0, 0.1, 0.75),
    new THREE.Vector3(3.18, -0.55, 1.84)
  ]);
  addSignalCurve([
    new THREE.Vector3(-2.92, -0.55, 1.75),
    new THREE.Vector3(-1.6, 0.1, 0.7),
    new THREE.Vector3(0.1, 0.6, 0),
    new THREE.Vector3(2.0, 0.1, -0.75),
    new THREE.Vector3(3.18, -0.55, -1.84)
  ]);

  const dataParticles = [];
  const particleGeometry = new THREE.SphereGeometry(0.046, 10, 8);
  const particleMaterial = new THREE.MeshBasicMaterial({
    color: 0xd8f5ff,
    transparent: true,
    opacity: 0.95,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });

  signalCurves.forEach((curve, curveIndex) => {
    for (let index = 0; index < 7; index += 1) {
      const particle = new THREE.Mesh(particleGeometry, particleMaterial.clone());
      particle.userData.curve = curve;
      particle.userData.offset = index / 7 + curveIndex * 0.09;
      particle.userData.speed = 0.035 + curveIndex * 0.006;
      world.add(particle);
      register(particle, 'signal');
      dataParticles.push(particle);
    }
  });

  const scanPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(7.8, 4.4),
    new THREE.MeshBasicMaterial({
      color: 0x5cc7ff,
      transparent: true,
      opacity: 0.045,
      side: THREE.DoubleSide,
      depthWrite: false,
      blending: THREE.AdditiveBlending
    })
  );
  scanPlane.rotation.y = Math.PI / 2;
  scanPlane.position.set(-4.5, 0.2, 0);
  world.add(scanPlane);

  const grid = new THREE.GridHelper(28, 42, 0x1a567e, 0x0a2335);
  grid.position.y = -1.22;
  grid.material.transparent = true;
  grid.material.opacity = 0.2;
  grid.material.depthWrite = false;
  scene.add(grid);

  const ringGroup = new THREE.Group();
  ringGroup.rotation.x = Math.PI / 2;
  ringGroup.position.set(0.9, 0.15, -2.5);
  scene.add(ringGroup);
  for (let index = 0; index < 7; index += 1) {
    const points = [];
    const radius = 3.6 + index * 0.68;
    for (let point = 0; point <= 96; point += 1) {
      const angle = (point / 96) * Math.PI * 2;
      points.push(new THREE.Vector3(Math.cos(angle) * radius, Math.sin(angle) * radius, 0));
    }
    ringGroup.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(points),
      new THREE.LineBasicMaterial({
        color: 0x2f86bd,
        transparent: true,
        opacity: 0.055 + index * 0.006,
        depthWrite: false
      })
    ));
  }

  const starCount = 520;
  const starPositions = new Float32Array(starCount * 3);
  for (let index = 0; index < starCount; index += 1) {
    starPositions[index * 3] = (Math.random() - 0.5) * 32;
    starPositions[index * 3 + 1] = (Math.random() - 0.2) * 13;
    starPositions[index * 3 + 2] = (Math.random() - 0.5) * 24;
  }
  const starGeometry = new THREE.BufferGeometry();
  starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
  const stars = new THREE.Points(starGeometry, new THREE.PointsMaterial({
    color: 0x74b9e8,
    size: 0.025,
    transparent: true,
    opacity: 0.26,
    depthWrite: false,
    blending: THREE.AdditiveBlending
  }));
  scene.add(stars);

  const anchors = {
    front: new THREE.Vector3(-4.48, 0.15, -0.2),
    cockpit: new THREE.Vector3(0.15, 1.15, 0.1),
    rear: new THREE.Vector3(4.37, 1.05, 0.1)
  };

  let activeMode = 'systems';
  const setMode = (mode) => {
    activeMode = mode;
    modeButtons.forEach((button) => {
      const active = button.dataset.mode === mode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    Object.entries(categoryObjects).forEach(([category, objects]) => {
      const strength = category === mode ? 1 : category === 'systems' ? 0.36 : 0.1;
      objects.forEach((object) => {
        object.traverse?.((child) => {
          if (!child.material) return;
          const materials = Array.isArray(child.material) ? child.material : [child.material];
          materials.forEach((material) => {
            if (typeof material.opacity !== 'number') return;
            const base = material.userData.baseOpacity ?? material.opacity;
            material.opacity = base * strength;
            material.needsUpdate = true;
          });
        });
        if (object.material && typeof object.material.opacity === 'number') {
          const base = object.material.userData.baseOpacity ?? object.material.opacity;
          object.material.opacity = base * strength;
        }
      });
    });
  };

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => setMode(button.dataset.mode || 'systems'));
  });

  const viewState = {
    targetRotationX: -0.08,
    targetRotationY: -0.5,
    rotationX: -0.08,
    rotationY: -0.5,
    pointerDown: false,
    pointerId: null,
    lastX: 0,
    lastY: 0
  };

  const resetView = () => {
    viewState.targetRotationX = -0.08;
    viewState.targetRotationY = -0.5;
  };
  resetButton?.addEventListener('click', resetView);

  canvas.addEventListener('pointerdown', (event) => {
    viewState.pointerDown = true;
    viewState.pointerId = event.pointerId;
    viewState.lastX = event.clientX;
    viewState.lastY = event.clientY;
    canvas.setPointerCapture?.(event.pointerId);
  });

  canvas.addEventListener('pointermove', (event) => {
    if (!viewState.pointerDown || event.pointerId !== viewState.pointerId) return;
    const dx = event.clientX - viewState.lastX;
    const dy = event.clientY - viewState.lastY;
    viewState.lastX = event.clientX;
    viewState.lastY = event.clientY;
    viewState.targetRotationY += dx * 0.0065;
    viewState.targetRotationX = THREE.MathUtils.clamp(
      viewState.targetRotationX + dy * 0.0048,
      -0.58,
      0.38
    );
  });

  const releasePointer = (event) => {
