const wheelAssembly = (x, z, radius, front, side) => {
const assembly = new THREE.Group();
assembly.position.set(x, -0.56, z);
ri06Root.add(assembly);
trackExploded(assembly, [front ? -0.35 : 0.45, 0.1, side * 1.7]);
const tire = new THREE.Mesh(new THREE.TorusGeometry(radius * 0.68, radius * 0.29, 22, 72), tireMaterialRi06);
assembly.add(tire);
const sidewall = new THREE.Mesh(new THREE.CylinderGeometry(radius * 0.66, radius * 0.66, front ? 0.5 : 0.58, 64, 1, true), tireMaterialRi06.clone());
sidewall.rotation.x = Math.PI / 2;
assembly.add(sidewall);
const rim = new THREE.Mesh(new THREE.CylinderGeometry(radius * 0.47, radius * 0.47, front ? 0.52 : 0.6, 40), metal);
rim.rotation.x = Math.PI / 2;
assembly.add(rim);
const rimVoid = new THREE.Mesh(new THREE.CylinderGeometry(radius * 0.37, radius * 0.37, front ? 0.55 : 0.63, 40), carbonSoft);
rimVoid.rotation.x = Math.PI / 2;
assembly.add(rimVoid);
const brake = new THREE.Mesh(new THREE.CylinderGeometry(radius * 0.31, radius * 0.31, 0.075, 48), brakeMaterial);
brake.rotation.x = Math.PI / 2;
brake.position.z = side * -0.055;
assembly.add(brake);
const caliper = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.42, 0.11), accent);
caliper.position.set(0.2, 0, side * -0.11);
assembly.add(caliper);
const hub = new THREE.Mesh(new THREE.CylinderGeometry(radius * 0.095, radius * 0.095, front ? 0.64 : 0.72, 18), titanium);
hub.rotation.x = Math.PI / 2;
assembly.add(hub);
for (let index = 0; index < 12; index += 1) {
const angle = (index / 12) * Math.PI * 2;
const spoke = new THREE.Mesh(new THREE.BoxGeometry(radius * 0.39, 0.032, 0.035), metal);
spoke.position.set(Math.cos(angle) * radius * 0.19, Math.sin(angle) * radius * 0.19, side * 0.012);
spoke.rotation.z = angle;
assembly.add(spoke);
}
const tyreRing = new THREE.Mesh(new THREE.TorusGeometry(radius * 0.75, 0.012, 8, 80), front ? luminous.clone() : redLuminous.clone());
tyreRing.position.z = side * (front ? 0.27 : 0.31);
tyreRing.material.opacity = front ? 0.48 : 0.32;
tyreRing.material.userData.baseOpacity = tyreRing.material.opacity;
assembly.add(tyreRing);
register(assembly, 'systems');
return assembly;
};
