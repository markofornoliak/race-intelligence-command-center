    edgeOpacity: 0.9
  });
  makeStrut([0.43, 1.39, 0], [0.59, 0.64, 0], 0.05, 'systems', 0.92);

  addWirePart(new THREE.TorusGeometry(0.26, 0.045, 8, 24), {
    position: [1.72, 1.08, 0],
    rotation: [Math.PI / 2, 0, 0],
    scale: [1, 1.25, 1],
    category: 'systems',
    surfaceOpacity: 0.07,
    edgeOpacity: 0.7
  });

  const aeroCurves = [];
  const addFlowCurve = (points, offset = 0) => {
    const curve = new THREE.CatmullRomCurve3(points);
    const line = new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(curve.getPoints(120)),
      lineMaterial('aero', 0.32)
    );
    line.userData.offset = offset;
    world.add(line);
    register(line, 'aero');
    aeroCurves.push({ line, offset });
  };

  for (let lane = -2; lane <= 2; lane += 1) {
    const z = lane * 0.62;
    addFlowCurve([
      new THREE.Vector3(-7.2, 0.2 + Math.abs(lane) * 0.08, z * 1.25),
      new THREE.Vector3(-4.8, 0.18, z),
      new THREE.Vector3(-2.4, 0.55 + Math.abs(lane) * 0.12, z * 0.8),
      new THREE.Vector3(0.4, 0.68, z * 0.72),
      new THREE.Vector3(3.1, 0.35 + Math.abs(lane) * 0.1, z * 0.9),
      new THREE.Vector3(6.4, 0.95 + Math.abs(lane) * 0.2, z * 1.5)
