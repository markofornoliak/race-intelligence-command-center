  makeStrut([4.22, 0.25, -0.35], [4.56, 1.12, -0.35], 0.04, 'aero');
  makeStrut([4.22, 0.25, 0.35], [4.56, 1.12, 0.35], 0.04, 'aero');

  [-1, 1].forEach((side) => {
    makeWingElement([3.96, -0.52, side * 0.94], [0.93, 0.055, 0.7], [0, side * 0.08, side * 0.12]);
    makeWingElement([4.24, -0.37, side * 1.22], [0.69, 0.045, 0.45], [0, side * 0.14, side * 0.2]);
