  const tireMaterial = new THREE.MeshPhysicalMaterial({
    color: 0x02070c,
    roughness: 0.74,
    metalness: 0.04,
    transparent: true,
    opacity: 0.74,
    depthWrite: false
  });

  const wheelGroups = [];
  const makeWheel = (x, z, front = false) => {
    const radius = front ? 0.78 : 0.87;
    const width = front ? 0.54 : 0.62;
    const group = new THREE.Group();
    group.position.set(x, -0.55, z);
    car.add(group);

    const tireGeometry = new THREE.CylinderGeometry(radius, radius, width, 36, 1, true);
    const tire = new THREE.Mesh(tireGeometry, tireMaterial.clone());
    tire.rotation.x = Math.PI / 2;
    group.add(tire);

    const tireEdges = new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.CylinderGeometry(radius, radius, width, 20, 1, true), 8),
      lineMaterial('systems', 0.56)
    );
    tireEdges.rotation.x = Math.PI / 2;
    group.add(tireEdges);

    addWirePart(new THREE.CylinderGeometry(radius * 0.52, radius * 0.52, width * 1.03, 20, 1, true), {
      parent: group,
      rotation: [Math.PI / 2, 0, 0],
      category: 'systems',
      surfaceOpacity: 0.05,
      edgeOpacity: 0.68,
      glow: false
    });

    addWirePart(new THREE.CylinderGeometry(radius * 0.16, radius * 0.16, width * 1.12, 12), {
      parent: group,
      rotation: [Math.PI / 2, 0, 0],
      category: 'systems',
      surfaceOpacity: 0.1,
      edgeOpacity: 0.82,
      glow: false
    });

    for (let index = 0; index < 10; index += 1) {
      const angle = (index / 10) * Math.PI * 2;
      const spoke = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(0, Math.cos(angle) * radius * 0.47, Math.sin(angle) * radius * 0.47),
          new THREE.Vector3(0, 0, 0)
        ]),
        lineMaterial('systems', 0.44)
      );
      spoke.rotation.y = Math.PI / 2;
      group.add(spoke);
    }

    register(group, 'systems');
    wheelGroups.push(group);
  };

  makeWheel(-2.92, -1.75, true);
  makeWheel(-2.92, 1.75, true);
  makeWheel(3.18, -1.84, false);
  makeWheel(3.18, 1.84, false);

  [-1, 1].forEach((side) => {
