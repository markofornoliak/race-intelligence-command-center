  const haloCurve = new THREE.CatmullRomCurve3([
    new THREE.Vector3(-0.56, 0.64, -0.53),
    new THREE.Vector3(-0.16, 1.22, -0.65),
    new THREE.Vector3(0.43, 1.39, 0),
    new THREE.Vector3(-0.16, 1.22, 0.65),
    new THREE.Vector3(-0.56, 0.64, 0.53)
