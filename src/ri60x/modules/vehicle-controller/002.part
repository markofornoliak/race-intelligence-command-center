Geometry = customLoft([
      { x: .45, y: .85, z: 0, width: .62, height: .50 },
      { x: 1.2, y: .92, z: 0, width: .46, height: .68 },
      { x: 2.05, y: .73, z: 0, width: .28, height: .38 }
    ]);
    const engineCover = named(shadow(new THREE.Mesh(engineCoverGeometry, M('paint'))), 'Engine cover', 'Power unit', 'Aerodynamic fairing around power unit, cooling spine and rear suspension.');
    this.add(engineCover);

    const noseGeometry = customLoft([
      { x: -3.1, y: .48, z: 0, width: .13, height: .13 },
      { x: -2.65, y: .52, z: 0, width: .24, height: .22 },
      { x: -2.15, y: .58, z: 0, width: .36, height: .30 },
      { x: -1.58, y: .62, z: 0, width: .52, height: .38 }
    ]);
    const nose = named(shadow(new THREE.Mesh(noseGeometry, M('paint'))), 'Nose cone', 'Aerodynamics', 'Slender crash structure feeding clean flow beneath the chassis.');
    this.add(nose);

    const vanity = box(new THREE.Vector3(.62, .13, .38), M('carbon'), .06);
    vanity.position.set(-1.6, .73, 0);
    vanity.rotation.z = -.08;
    this.add(vanity);

    this.buildFrontWing();
    this.buildSidepods();
    this.buildCockpit();
    this.buildRearWing();
    this.buildDiffuser();
    this.buildWheelsAndSuspension();
    this.buildDetailing();
  }

  buildFrontWing() {
    const M = (name) => this.materials.get(name);
    const wing = new THREE.Group();
    wing.name = 'FRONT_WING_ASSEMBLY';
    wing.position.set(-3.22, .13, 0);
    this.add(wing);

    const main = named(box(new THREE.Vector3(.48, .045, 2.25), M('carbon'), .018), 'Front wing mainplane', 'Aerodynamics', 'Primary front downforce surface and flow conditioner.');
    main.rotation.z = THREE.MathUtils.degToRad(5);
    wing.add(main);
    this.components.push(main);

    for (let flap = 0; flap < 3; flap += 1) {
      const element = box(new THREE.Vector3(.34 - flap * .04, .028, 2.02 - flap * .13), flap === 2 ? M('accent') : M('carbon'), .012);
      element.position.set(.18 + flap * .15, .08 + flap * .06, 0);
      element.rotation.z = THREE.MathUtils.degToRad(8 + flap * 3.5);
      wing.add(element);
    }
    for (const side of [-1, 1]) {
      const endplate = box(new THREE.Vector3(.52, .32, .035), M('carbon'), .015);
      endplate.position.set(.05, .12, side * 1.16);
      endplate.rotation.x = side * THREE.MathUtils.degToRad(3);
      wing.add(endplate);
      const foot = box(new THREE.Vector3(.32, .025, .16), M('carbonMatte'), .01);
      foot.position.set(-.12, -.035, side * 1.08);
      wing.add(foot);
    }
    const nosePylonL = cylinderBetween(new THREE.Vector3(-.02, .17, -.11), new THREE.Vector3(.28, .42, -.11), .025, M('titanium'));
    const nosePylonR = nosePylonL.clone();
    nosePylonR.position.z *= -1;
    wing.add(nosePylonL, nosePylonR);
  }

  buildSidepods() {
    const M = (name) => this.materials.get(name);
    for (const side of [-1, 1]) {
      const geometry = customLoft([
        { x: -.55, y: .59, z: side * .58, width: .46, height: .43 },
        { x: .05, y: .62, z: side * .72, width: .52, height: .55 },
        { x: .82, y: .55, z: side * .67, width: .42, height: .40 },
        { x: 1.35, y: .47, z: side * .48, width: .22, height: .24 }
      ]);
      const pod = named(shadow(new THREE.Mesh(geometry, M('paint'))), side < 0 ? 'Left sidepod' : 'Right sidepod', 'Cooling', 'High undercut sidepod with compact cooling exit.');
      this.add(pod);

      const intake = new THREE.Mesh(new THREE.TorusGeometry(.18, .048, 10, 28, Math.PI * 1.55), M('dark'));
      intake.rotation.set(0, Math.PI / 2, side * Math.PI / 2);
      intake.position.set(-.53, .7, side * .68);
      intake.scale.set(1, 1.22, 1);
      this.add(shadow(intake));

      const undercut = box(new THREE.Vector3(1.22, .17, .26), M('dark'), .08);
      undercut.position.set(.25, .31, side * .67);
      undercut.rotation.z = -.035;
      this.add(undercut);

      for (let fence = 0; fence < 3; fence += 1) {
        const floorFence = box(new THREE.Vector3(.62 + fence * .14, .15, .025), M('carbonMatte'), .008);
        floorFence.position.set(-.65 + fence * .35, .11, side * (.66 + fence * .085));
        floorFence.rotation.z = -.045;
        this.add(floorFence);
      }
    }
  }

  buildCockpit() {
    const M = (name) => this.materials.get(name);
    const cockpit = named(shadow(new THREE.Mesh(new THREE.TorusGeometry(.43, .105, 16, 48, Math.PI * 1.55), M('carbon'))), 'Cockpit surround', 'Driver cell', 'Padded cockpit rim and upper survival-cell structure.');
    cockpit.rotation.set(Math.PI / 2, 0, Math.PI * .225);
    cockpit.scale.set(1.25, 1, .72);
    cockpit.position.set(-.12, .86, 0);
    this.add(cockpit);

    const seat = box(new THREE.Vector3(.62, .12, .42), M('carbonMatte'), .08);
    seat.position.set(.08, .72, 0);
    seat.rotation.z = -.22;
    this.add(seat);

    const steering = new THREE.Group();
    steering.position.set(-.35, .83, 0);
    steering.rotation.y = Math.PI / 2;
    const rim = new THREE.Mesh(new THREE.TorusGeometry(.13, .022, 10, 28), M('carbonMatte'));
    rim.scale.y = .78;
    steering.add(rim);
    const hub = box(new THREE.Vector3(.05, .16, .18), M('magnesium'), .02);
    steering.add(hub);
    for (let button = 0; button < 8; button += 1) {
      const dot = new THREE.Mesh(new THREE.SphereGeometry(.012, 8, 6), button % 2 ? M('accent') : M('aluminium'));
      const angle = (button / 8) * Math.PI * 2;
      dot.position.set(.03, Math.sin(angle) * .075, Math.cos(angle) * .09);
      steering.add(dot);
    }
    this.add(steering);

    const halo = new THREE.Group();
    halo.name = 'HALO_ASSEMBLY';
    const center = cylinderBetween(new THREE.Vector3(-.48, .89, 0), new THREE.Vector3(-.12, 1.34, 0), .045, M('titanium'));
    halo.add(center);
    const left = cylinderBetween(new THREE.Vector3(-.12, 1.34, 0), new THREE.Vector3(.43, 1.08, -.39), .043, M('titanium'));
    const right = cylinderBetween(new THREE.Vector3(-.12, 1.34, 0), new THREE.Vector3(.43, 1.08, .39), .043, M('titanium'));
    halo.add(