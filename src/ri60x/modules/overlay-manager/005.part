
OverlayManager.prototype.updateDynamics = function updateDynamicsRI602Axes(delta) {
  if (!this.dynamicsBuilt || !this.groups.dynamics.visible) return null;
  let state;
  if (this.playbackFrames?.length) {
    state = this.playbackFrames[Math.floor(this.playbackIndex) % this.playbackFrames.length];
    this.playbackIndex += delta * 60;
    if (this.playbackIndex >= this.playbackFrames.length) this.playbackFrames = null;
  } else {
    const duration = this.event === 'kerb' ? 1.8 : 3.5;
    this.eventPhase = (this.eventPhase + delta / duration) % 1;
    state = this.dynamicState(this.eventPhase);
    if (this.recording) {
      this.recordedFrames.push(structuredClone(state));
      if (this.recordedFrames.length > 360) this.setRecording(false);
    }
  }

  // Vehicle longitudinal axis is X, lateral axis is Z: roll rotates around X, pitch around Z.
  this.dynamicFrame.rotation.x = THREE.MathUtils.degToRad(state.roll);
  this.dynamicFrame.rotation.z = THREE.MathUtils.degToRad(state.pitch);
  this.dynamicFrame.position.y = 1.13 + state.heave / 1000;

  for (const [key, marker] of Object.entries(this.suspensionMarkers)) {
    const travel = state.travel[key];
    const compression = travel >= 0;
    const color = compression ? 0xff6b73 : 0x61d398;
    marker.ring.material.color.setHex(color);
    marker.travel.material.color.setHex(color);
    marker.travelHead.material.color.setHex(color);
    const normalizedTravel = Math.min(Math.abs(travel) / 35, 1);
    marker.travel.scale.y = .45 + normalizedTravel * .75;
    marker.travelHead.position.y = .34 + normalizedTravel * .22;
    marker.travelHead.rotation.z = compression ? Math.PI : 0;
    this.contactPatches[key].material.color.setHex(color);
    this.contactPatches[key].scale.x = 1 + Math.min(state.loads[key] / 12, 1) * .42;
    this.contactPatches[key].scale.y = .4 + Math.min(state.loads[key] / 12, 1) * .28;
  }

  for (const { key, arrow } of this.loadVectors) {
    const normalized = clamp(state.loads[key] / 11, .24, 1);
    const length = clamp(.22 + normalized * .56, .22, .78);
    arrow.setLength(length, Math.min(.13, length * .22), Math.min(.07, length * .13));
    arrow.position.y = .665;
  }
  return state;
};
