ck-actions button small{display:block}.hero__quick-actions button span{font-size:13px;font-weight:650}.hero__quick-actions button small{margin-top:4px;color:var(--subtle);font-size:10px}.hero__quick-actions button.is-active{background:rgba(255,255,255,.085)}.hero__quick-actions button.is-active span{color:var(--accent)}
.viewport__label{position:absolute;z-index:5;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:11px;letter-spacing:.03em}.viewport__label span:first-child{color:var(--text);font-weight:650}.viewport__label--top{top:24px;right:28px}.viewport__label--bottom{right:28px;bottom:26px}.viewport__label span+span::before{content:"/";margin-right:10px;color:var(--subtle)}
.focus-reticle{position:absolute;z-index:7;left:50%;top:50%;width:42px;height:42px;transform:translate(-50%,-50%);opacity:.22;pointer-events:none}.focus-reticle i{position:absolute;background:var(--accent)}.focus-reticle i:first-child{left:0;right:0;top:50%;height:1px}.focus-reticle i:last-child{top:0;bottom:0;left:50%;width:1px}
.toast-stack{position:absolute;z-index:20;right:22px;top:66px;display:flex;flex-direction:column;gap:8px;pointer-events:none}.toast{max-width:330px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:rgba(14,18,24,.92);box-shadow:var(--shadow);color:var(--muted);font-size:12px;animation:toast-in .25s ease}.toast strong{display:block;margin-bottom:3px;color:var(--text)}@keyframes toast-in{from{opacity:0;transform:translateY(-8px)}}
.component-tooltip{position:absolute;z-index:18;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:rgba(10,13,18,.9);font-size:11px;pointer-events:none;transform:translate(12px,12px)}
.viewport__fallback{position:absolute;inset:0;z-index:15;display:grid;place-content:center;text-align:center;background:radial-gradient(circle,#17212c,#080b0f 65%)}.viewport__fallback strong{font-size:22px}.viewport__fallback p{color:var(--muted)}.fallback-car{width:340px;height:120px;margin:0 auto 28px;position:relative;filter:drop-shadow(0 18px 22px rgba(0,0,0,.5))}.fallback-car::before{content:"";position:absolute;left:54px;right:54px;top:44px;height:30px;border-radius:70% 35% 20% 20%;background:linear-gradient(90deg,#1d232a,#39424d 48%,#171b20)}.fallback-car::after{content:"";position:absolute;left:4px;right:4px;top:70px;height:8px;border-radius:10px;background:#171b20;box-shadow:42px 0 0 20px #070809,255px 0 0 20px #070809}
.bottom-dock{position:fixed;z-index:110;left:0;right:0;bottom:0;height:var(--dock-height);display:flex;justify-content:center;gap:8px;padding:9px max(14px,env(safe-area-inset-right)) calc(9px + env(safe-area-inset-bottom)) max(14px,env(safe-area-inset-left));border-top:1px solid var(--line);background:rgba(8,11,15,.9);backdrop-filter:blur(18px)}.bottom-dock button{width:min(190px,22vw);padding:10px 14px;border:1px solid transparent;border-radius:11px;background:transparent;text-align:left;cursor:pointer}.bottom-dock span,.bottom-dock small{display:block}.bottom-dock span{font-size:13px;font-weight:650}.bottom-dock small{margin-top:3px;color:var(--subtle);font-size:10px}.bottom-dock button:hover,.bottom-dock button.is-active{border-color:var(--line);background:rgba(255,255,255,.045)}.bottom-dock button.is-active span{color:var(--accent)}
.workspace{position:absolute;z-index:30;top:calc(var(--topbar-height) + 14px);right:18px;bottom:calc(var(--dock-height) + 15px);width:min(430px,calc(100vw - 36px));border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);box-shadow:var(--shadow);backdrop-filter:blur(22px);overflow:hidden;animation:panel-in .3s ease}@keyframes panel-in{from{opacity:0;transform:translateX(20px)}}.workspace__nav{height:48px;display:grid;grid-template-columns:repeat(3,1fr);padding:5px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.02)}.workspace__nav button{border:0;border-radius:8px;background:transparent;color:var(--muted);font-size:12px;font-weight:650;cursor:pointer}.workspace__nav button.is-active{background:rgba(255,255,255,.08);color:var(--text)}.workspace__body{height:calc(100% - 48px);overflow:hidden}.control-panel,.analysis-panel{height:100%;overflow:auto;padding:18px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.18) transparent}.analysis-panel{width:100%}.panel-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px}.panel-heading>div{display:flex;flex-direction:column;gap:3px}.panel-heading span{color:var(--muted);font-size:11px}.panel-heading strong{font-size:23px;letter-spacing:-.035em}.close-button{width:34px;height:34px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.035);font-size:20px;cursor:pointer}
.control-section{margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}.control-section>header,.chart-card>header,.wheel-card>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.control-section>header span,.chart-card>header>span,.wheel-card>header>span{font-size:12px;font-weight:650}.control-section>header button,.chart-card header button{border:0;background:transparent;color:var(--accent);font-size:10px;font-weight:700;cursor:pointer}.mode-list,.quality-list{display:grid;gap:7px}.mode-list button,.quality-list button{display:flex;justify-content:space-between;align-items:center;min-height:48px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.02);text-align:left;cursor:pointer}.mode-list button:hover,.mode-list button.is-active,.quality-list button:hover,.quality-list button.is-active{border-color:var(--line-strong);background:rgba(255,255,255,.07)}.mode-list strong,.quality-list strong{font-size:12px}.mode-list small,.quality-list small{color:var(--subtle);font-size:10px}.mode-list button.is-active strong,.quality-list button.is-active strong{color:var(--accent)}
.camera-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.camera-grid button,