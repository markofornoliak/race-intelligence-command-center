.preset-row button,.event-grid button{min-height:36px;padding:7px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.025);font-size:10px;font-weight:650;cursor:pointer}.camera-grid button:hover,.camera-grid button.is-active,.preset-row button:hover,.preset-row button.is-active,.event-grid button:hover,.event-grid button.is-active{background:var(--accent-soft);border-color:rgba(255,80,56,.42);color:#fff}.preset-row{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.toggle-list{display:grid;gap:8px}.toggle-list label{display:flex;align-items:center;gap:9px;padding:9px 10px;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.02);font-size:11px;cursor:pointer}.toggle-list input{accent-color:var(--accent)}.range-field{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:14px;color:var(--muted);font-size:11px}.range-field input{grid-column:1/-1;width:100%;accent-color:var(--accent)}.range-field output{color:var(--text);font-variant-numeric:tabular-nums}.aero-balance{margin-top:15px}.aero-balance>span{font-size:11px;color:var(--muted)}.aero-balance>div{display:flex;height:8px;margin:8px 0;border-radius:99px;overflow:hidden;background:#1d232c}.aero-balance i:first-child{background:var(--accent)}.aero-balance i:last-child{background:#8ba4bd}.aero-balance strong{font-size:11px;font-variant-numeric:tabular-nums}.event-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}
.metric-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.metric-grid>div{min-height:94px;padding:13px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.025)}.metric-grid span,.telemetry-kpis span{display:block;color:var(--muted);font-size:10px}.metric-grid strong{display:block;margin-top:12px;font-size:20px;font-variant-numeric:tabular-nums}.metric-grid small{display:block;margin-top:4px;color:var(--subtle);font-size:9px}.metric-grid--compact>div{min-height:72px}.metric-grid--compact strong{margin-top:7px;font-size:16px}.status-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}.status-list li{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;padding:9px 10px;border:1px solid var(--line);border-radius:9px;font-size:10px}.status-list i{width:7px;height:7px;border-radius:50%;background:var(--success)}.status-list span{color:var(--muted)}.status-list strong{font-weight:650}
.telemetry-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:12px}.telemetry-kpis>div{padding:10px 8px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.025);text-align:center}.telemetry-kpis strong{display:block;margin-top:6px;font-size:18px;font-variant-numeric:tabular-nums}.telemetry-kpis small{display:block;margin-top:2px;color:var(--subtle);font-size:8px}.chart-card,.wheel-card{padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.02);margin-bottom:11px}.chart-card header>div{display:flex;gap:4px}.chart-card header button{padding:5px 7px;border:1px solid var(--line);border-radius:6px;color:var(--muted)}.chart-card canvas{display:block;width:100%;height:190px}.chart-legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;color:var(--muted);font-size:9px}.chart-legend i{display:inline-block;width:14px;height:2px;margin-right:5px;vertical-align:middle}.chart-legend i[data-series="speed"]{background:#f5f7fa}.chart-legend i[data-series="throttle"]{background:#61d398}.chart-legend i[data-series="brake"]{background:#ff6b73}.chart-legend i[data-series="tyre"]{background:#f0b45f}.wheel-card header strong{font-size:10px;color:var(--muted)}.wheel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.wheel-grid>div{padding:10px;border-radius:9px;background:rgba(255,255,255,.035)}.wheel-grid span,.wheel-grid small{display:block;color:var(--muted);font-size:9px}.wheel-grid strong{display:block;margin-top:6px;font-size:15px;font-variant-numeric:tabular-nums}.wheel-grid small{margin-top:3px}.wheel-grid i{display:block;height:4px;margin-top:8px;border-radius:99px;background:#232a33;overflow:hidden}.wheel-grid b{display:block;height:100%;width:50%;background:var(--accent)}
.timeline{display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:9px;padding:10px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025)}.timeline>button{width:34px;height:34px;border:0;border-radius:8px;background:var(--accent);cursor:pointer}.timeline>strong{font-size:10px;font-variant-numeric:tabular-nums}.timeline label input{width:100%;accent-color:var(--accent)}.timeline__speed{display:flex;gap:3px}.timeline__speed button{padding:5px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--muted);font-size:9px;cursor:pointer}.timeline__speed button.is-active{color:var(--text);background:rgba(255,255,255,.08)}
.help-dialog{max-width:560px;width:calc(100% - 32px);padding:0;border:1px solid var(--line);border-radius:18px;background:#11161d;color:var(--text);box-shadow:var(--shadow)}.help-dialog::backdrop{background:rgba(0,0,0,.7);backdrop-filter:blur(6px)}.help-dialog form{position:relative;padding:28px}.help-dialog form>button{position:absolute;top:16px;right:16px;width:34px;height:34px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--text);font-size:20px}.help-dialog form>span{color:var(--accent);font-size:11px;font-weight:700}.help-dialog h2{max-width:440px;margin:12px 0 22px;font-size:30px;line-height:1.1;letter-spacing:-.04em}.help-dialog dl{margin:0;display:grid;gap:10px}.help-dialog dl div{display:grid;grid-template-columns:90px 1fr;gap:12px;padding-top:10px;border-top:1px solid var(--line)}.help-dialog dt{font-weight:650}.help-dialog dd{margin:0;color:var(--muted);line-height:1.5}
@media(max-width:1100px){.hero__copy{width:min(410px,44vw)}.hero h1{font-size:clamp(40px,5.4vw,68px)}.hero__quick-actions button{min-width:118px}.viewport::before{back