ground:linear-gradient(90deg,rgba(8,11,15,.9),rgba(8,11,15,.38) 32%,transparent 58%),linear-gradient(to top,rgba(8,11,15,.68),transparent 22%)}}
@media(max-width:760px){:root{--topbar-height:62px;--dock-height:76px}.topbar{grid-template-columns:1fr auto;padding-left:max(14px,env(safe-area-inset-left));padding-right:max(14px,env(safe-area-inset-right))}.topbar__center{display:none}.brand small{display:none}.topbar__actions .icon-button:first-child{display:none}.hero__copy{left:20px;right:20px;top:auto;bottom:112px;width:auto;transform:none}.hero__copy.is-hidden{transform:translateY(16px)}.eyebrow{margin-bottom:12px;font-size:9px}.hero h1{font-size:clamp(38px,11vw,56px)}.hero__copy>p:not(.eyebrow){max-width:520px;margin-top:15px;font-size:14px;line-height:1.5}.hero__actions{margin-top:18px}.primary-button,.secondary-button{height:44px;padding:0 15px;font-size:12px}.viewport::before{background:linear-gradient(to top,rgba(8,11,15,.98) 0,rgba(8,11,15,.76) 35%,transparent 68%)}.hero__quick-actions{left:14px;right:14px;bottom:12px;transform:none;overflow-x:auto;justify-content:flex-start}.hero__quick-actions button{min-width:116px;padding:10px 12px}.hero__quick-actions button small{display:none}.viewport__label--top{top:14px;right:14px}.viewport__label--bottom{display:none}.workspace{top:calc(var(--topbar-height) + 8px);left:8px;right:8px;bottom:calc(var(--dock-height) + 8px);width:auto;border-radius:17px}.workspace__body{overflow:hidden}.control-panel,.analysis-panel{padding:15px}.bottom-dock{justify-content:stretch;gap:4px;padding-top:7px}.bottom-dock button{flex:1;width:auto;padding:8px;text-align:center}.bottom-dock small{display:none}.bottom-dock span{font-size:11px}.camera-grid{grid-template-columns:repeat(4,1fr)}.telemetry-kpis{grid-template-columns:repeat(2,1fr)}.chart-card canvas{height:165px}}
@media(max-width:480px){.brand strong{font-size:13px}.topbar__actions{gap:5px}.icon-button{min-width:38px;height:34px}.hero__copy{bottom:98px}.hero h1{font-size:40px}.hero__copy>p:not(.eyebrow){display:none}.hero__actions{gap:8px}.secondary-button{display:none}.hero__quick-actions{display:none}.workspace{top:var(--topbar-height);left:0;right:0;bottom:var(--dock-height);border-left:0;border-right:0;border-radius:0}.workspace__nav{height:46px}.workspace__body{height:calc(100% - 46px)}.control-panel,.analysis-panel{padding:14px}.panel-heading strong{font-size:21px}.camera-grid{grid-template-columns:repeat(4,1fr)}.metric-grid{grid-template-columns:repeat(2,1fr)}.timeline{grid-template-columns:auto 1fr auto}.timeline>strong{display:none}.timeline__speed button:first-child{display:none}.chart-card{padding:10px}.chart-card canvas{height:148px}.help-dialog form{padding:24px 18px}.help-dialog h2{font-size:25px}.help-dialog dl div{grid-template-columns:72px 1fr}}
@media(orientation:landscape) and (max-height:520px) and (max-width:920px){:root{--topbar-height:54px;--dock-height:62px}.hero__copy{left:20px;bottom:24px;width:340px}.hero h1{font-size:38px}.hero__copy>p:not(.eyebrow){display:none}.hero__actions{margin-top:14px}.hero__quick-actions{left:auto;right:18px;bottom:14px}.bottom-dock button{padding:5px}.workspace{top:var(--topbar-height);bottom:var(--dock-height)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}}
html[data-quality="mobile"] .hero::after,html[data-quality="mobile"] .app::before{display:none}
html[data-quality="mobile"] .viewport__label--bottom{display:none}
