:root{
  color-scheme:dark;
  --bg:#080b0f;
  --bg-elevated:#0d1117;
  --panel:rgba(14,18,24,.88);
  --panel-solid:#10151c;
  --panel-soft:rgba(18,23,31,.72);
  --line:rgba(255,255,255,.1);
  --line-strong:rgba(255,255,255,.18);
  --text:#f4f6f8;
  --muted:#9aa4b2;
  --subtle:#687382;
  --accent:#ff5038;
  --accent-soft:rgba(255,80,56,.18);
  --success:#61d398;
  --warning:#f0b45f;
  --danger:#ff6b73;
  --shadow:0 24px 80px rgba(0,0,0,.42);
  --radius-lg:22px;
  --radius-md:14px;
  --radius-sm:9px;
  --topbar-height:72px;
  --dock-height:82px;
  font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-synthesis:none;
  text-rendering:optimizeLegibility;
}
*{box-sizing:border-box}
html{background:var(--bg);scroll-behavior:smooth}
body{margin:0;min-width:320px;min-height:100dvh;overflow:hidden;background:radial-gradient(circle at 50% 15%,#17202b 0,#0b0f14 34%,#07090c 78%);color:var(--text)}
button,input,select{font:inherit}
button{color:inherit}
button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
button{touch-action:manipulation}
[hidden]{display:none!important}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.skip-link{position:fixed;left:16px;top:-60px;z-index:2000;padding:12px 16px;border-radius:8px;background:#fff;color:#000;text-decoration:none;transition:top .2s}.skip-link:focus{top:16px}
.app{position:relative;min-height:100dvh;overflow:hidden}
.app::before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.45),transparent 82%)}
.topbar{position:fixed;z-index:100;top:0;left:0;right:0;height:var(--topbar-height);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 max(22px,env(safe-area-inset-left)) 0 max(22px,env(safe-area-inset-right));border-bottom:1px solid var(--line);background:linear-gradient(to bottom,rgba(8,11,15,.92),rgba(8,11,15,.68));backdrop-filter:blur(18px)}
.brand{display:inline-flex;align-items:center;gap:12px;color:inherit;text-decoration:none;min-width:0}.brand__glyph{position:relative;width:31px;height:31px;border:1px solid var(--line-strong);border-radius:9px;display:grid;place-items:center;overflow:hidden;background:rgba(255,255,255,.03)}.brand__glyph i{position:absolute;width:18px;height:4px;background:var(--accent);transform:skewX(-24deg)}.brand__glyph i:first-child{transform:translateY(-5px) skewX(-24deg)}.brand__glyph i:last-child{transform:translateY(5px) skewX(-24deg);opacity:.45}.brand span:last-child{display:flex;flex-direction:column;gap:2px;min-width:0}.brand strong{font-size:15px;letter-spacing:-.02em}.brand small{font-size:11px;color:var(--muted);white-space:nowrap}
.topbar__center{display:flex;align-items:center;gap:9px;font-size:12px;color:var(--muted);padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.025)}.topbar__center strong{font-variant-numeric:tabular-nums;color:var(--text);font-weight:600}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 12px rgba(97,211,152,.65)}
.topbar__actions{justify-self:end;display:flex;gap:8px}.icon-button{height:36px;min-width:44px;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.035);font-size:11px;font-weight:700;letter-spacing:.04em;cursor:pointer}.icon-button:hover{background:rgba(255,255,255,.08);border-color:var(--line-strong)}
.stage-shell{height:100dvh;padding-top:var(--topbar-height);padding-bottom:var(--dock-height)}
.hero{position:relative;height:100%;overflow:hidden}.hero::after{content:"";position:absolute;z-index:0;inset:auto 10% -25% 10%;height:48%;background:radial-gradient(ellipse,rgba(38,53,69,.5),transparent 68%);filter:blur(24px);pointer-events:none}
.viewport{position:absolute;inset:0;z-index:1}.viewport canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}.viewport canvas:active{cursor:grabbing}
.viewport::before{content:"";position:absolute;z-index:2;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(8,11,15,.92) 0%,rgba(8,11,15,.45) 25%,transparent 46%),linear-gradient(to top,rgba(8,11,15,.68),transparent 22%)}
.hero__copy{position:absolute;z-index:6;left:clamp(24px,5.5vw,88px);top:50%;width:min(440px,38vw);transform:translateY(-54%);transition:opacity .45s ease,transform .45s ease}.hero__copy.is-hidden{opacity:0;pointer-events:none;transform:translate(-22px,-54%)}
.eyebrow{margin:0 0 18px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.16em}.hero h1{margin:0;font-size:clamp(42px,5.1vw,82px);line-height:.97;letter-spacing:-.055em;font-weight:690}.hero h1 span{color:#aeb8c5}.hero__copy>p:not(.eyebrow){max-width:590px;margin:24px 0 0;color:var(--muted);font-size:clamp(15px,1.1vw,18px);line-height:1.65}.hero__actions{display:flex;gap:12px;margin-top:30px}.primary-button,.secondary-button{height:48px;padding:0 20px;border-radius:11px;border:1px solid transparent;font-weight:650;cursor:pointer}.primary-button{background:var(--accent);color:#fff;box-shadow:0 14px 36px rgba(255,80,56,.18)}.primary-button:hover{filter:brightness(1.08)}.secondary-button{background:rgba(255,255,255,.045);border-color:var(--line);color:var(--text)}.secondary-button:hover{background:rgba(255,255,255,.085)}
.hero__quick-actions{position:absolute;z-index:8;left:50%;bottom:25px;transform:translateX(-50%);display:flex;padding:5px;border:1px solid var(--line);border-radius:15px;background:rgba(10,14,19,.78);box-shadow:var(--shadow);backdrop-filter:blur(18px)}.hero__quick-actions button{min-width:140px;padding:12px 16px;border:0;border-radius:10px;background:transparent;text-align:left;cursor:pointer}.hero__quick-actions button span,.hero__qui