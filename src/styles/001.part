:root {
  --ink: #02050a;
  --ink-soft: #050b13;
  --panel: #07111d;
  --panel-2: #091827;
  --white: #f4f8fb;
  --muted: #8b9bad;
  --muted-2: #5f7185;
  --blue: #73c7ff;
  --blue-bright: #c3edff;
  --blue-deep: #0a5a91;
  --red: #ff3138;
  --green: #55dba0;
  --line: rgba(118, 185, 236, 0.14);
  --line-strong: rgba(118, 185, 236, 0.34);
  --display: "Arial Narrow", "Helvetica Neue Condensed", Impact, sans-serif;
  --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  --body: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --ease: cubic-bezier(0.22, 0.84, 0.24, 1);
  --page-pad: clamp(24px, 5.2vw, 88px);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--ink); }
body {
  margin: 0;
  min-width: 320px;
  background: var(--ink);
  color: var(--white);
  font-family: var(--body);
  overflow-x: hidden;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}
body.is-locked { overflow: hidden; }
a { color: inherit; }
button, a { font: inherit; }
button { color: inherit; }
::selection { background: rgba(115, 199, 255, 0.28); color: #fff; }
[hidden] { display: none !important; }

.skip-link {
  position: fixed;
  z-index: 9999;
  left: 14px;
  top: 14px;
  padding: 10px 14px;
  background: #fff;
  color: #000;
  transform: translateY(-180%);
}
.skip-link:focus { transform: none; }
:focus-visible { outline: 2px solid var(--blue-bright); outline-offset: 4px; }

.boot {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-content: center;
  grid-template-columns: auto minmax(240px, 420px);
  gap: 16px 24px;
  padding: 30px;
  background:
    radial-gradient(circle at 50% 45%, rgba(26, 106, 165, 0.15), transparent 28%),
    #010307;
  transition: opacity 0.85s var(--ease), visibility 0.85s;
}
.boot::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(115, 199, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(115, 199, 255, 0.035) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: radial-gradient(circle, #000 0%, transparent 68%);
}
.boot.is-complete { opacity: 0; visibility: hidden; }
.boot__mark {
  position: relative;
  z-index: 1;
  grid-row: span 2;
  width: 56px;
  height: 56px;
  border: 1px solid rgba(115, 199, 255, 0.35);
  display: grid;
  place-items: center;
  transform: skewX(-11deg);
}
.boot__mark::before,
.boot__mark::after,
.boot__mark span {
  content: "";
  position: absolute;
  height: 2px;
  background: var(--blue);
  box-shadow: 0 0 16px rgba(115, 199, 255, 0.72);
}
.boot__mark::before { width: 30px; transform: translateY(-8px); }
.boot__mark::after { width: 22px; transform: translate(5px, 8px); }
.boot__mark span:first-child { width: 14px; transform: translate(-9px, 0); }
.boot__mark span:last-child { width: 8px; transform: translate(12px, 0); background: var(--red); }
.boot__copy { position: relative; z-index: 1; display: grid; gap: 7px; align-self: end; }
.boot__copy strong { font: 800 12px/1 var(--body); letter-spacing: 0.26em; }
.boot__copy span { color: #71859a; font: 700 8px/1 var(--mono); letter-spacing: 0.18em; }
.boot__line {
  position: relative;
  z-index: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}
.boot__line i {
  display: block;
  width: 38%;
  height: 100%;
  background: var(--blue);
  box-shadow: 0 0 18px rgba(115, 199, 255, 0.9);
  animation: bootline 1.15s var(--ease) forwards;
}
.boot__status {
  position: relative;
  z-index: 1;
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 12px;
  color: #5b6e81;
  font: 700 7px/1 var(--mono);
  letter-spacing: 0.14em;
}
@keyframes bootline { from { transform: translateX(-110%); } to { transform: translateX(278%); } }

.topline {
  position: fixed;
  z-index: 90;
  inset: 0 0 auto;
  height: 76px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24px;
  padding: 0 var(--page-pad);
  border-bottom: 1px solid transparent;
  transition: height 0.3s, background 0.3s, border-color 0.3s;
}
.topline.is-scrolled {
  height: 62px;
  background: rgba(2, 5, 10, 0.84);
  backdrop-filter: blur(20px) saturate(1.25);
  border-color: var(--line);
}
.identity {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  width: max-content;
  text-decoration: none;
  font: 800 9px/1 var(--body);
  letter-spacing: 0.24em;
}
.identity__sigil {
  position: relative;
  width: 29px;
  height: 11px;
  border: 1px solid var(--blue);
  transform: skewX(-30deg);
}
.identity__sigil::after {
  content: "";
  position: absolute;
  right: -9px;
  top: -5px;
  width: 15px;
  height: 1px;
  background: var(--red);
}
.identity__sigil i {
  position: absolute;
  inset: 3px 6px;
  border-top: 1px solid rgba(115, 199, 255, 0.8);
  border-bottom: 1px solid rgba(115, 199, 255, 0.34);
}
.topline__nav { display: flex; gap: 32px; }
.topline__nav a {
  position: relative;
  padding: 10px 0;
  text-decoration: none;
  color: #8596a8;
  font: 800 8px/1 var(--body);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  transition: color 0.25s;
}
.topline__nav a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: 3px;
  height: 1px;
  background: var(--blue);
  transition: right 0.3s var(--ease);
}
.topline__nav a:hover,
.topline__nav a.is-active { color: #fff; }
.topline__nav a.is-active::after { right: 0; }
.topline__status {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #7d8ea0;
  font: 800 8px/1 var(--body);
  letter-spacing: 0.18em;
}
.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 14px var(--green);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse { 50% { opacity: 0.35; } }
.menu-toggle { display: none; }
.mobile-nav { display: none; }

.chapter-progress {
  position: fixed;
  z-index: 70;
  right: 18px;
  top: 50%;
  display: grid;
  justify-items: center;
  gap: 15px;
  transform: translateY(-50%);
  pointer-events: none;
}
.chapter-progress span,
.chapter-progress em {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  font-style: normal;
}
.chapter-progress span { font: 500 12px/1 var(--mono); letter-spacing: 0.08em; }
.chapter-progress em { color: #5f7185; font: 800 7px/1 var(--body); letter-spacing: 0.2em; }
.chapter-progress i {
  position: relative;
  width: 1px;
  height: 176px;
  background: rgba(255, 255, 255, 0.16);
}
.chapter-progress b {
  position: absolute;
  left: -1px;
  top: 0;
  width: 3px;
  height: 0;
  background: #fff;
  box-shadow: 0 0 14px rgba(255, 255, 255, 0.55);
  transition: height 0.15s linear;
}

.hero {
  position: relative;
  min-height: 100svh;
  overflow: hidden;
  background:
    radial-gradient(circle at 73% 42%, rgba(25, 104, 170, 0.2), transparent 31%),
    linear-gradient(180deg, #02050a 0%, #030810 64%, #040a12 100%);
}
.hero::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  z-index: 10;
  height: 20%;
  background: linear-gradient(transparent, rgba(2, 5, 10, 0.82));
  pointer-events: none;
}
.hero__atmosphere { position: absolute; inset: 0; pointer-events: none; }
.radar { position: absolute; border: 1px solid rgba(115, 199, 255, 0.1); border-radius: 50%; }
.radar::before,
.radar::after { content: ""; position: absolute; border: 1px dashed rgba(115, 199, 255, 0.085); border-radius: inherit; }
.radar::before { inset: 8%; }
.radar::after { inset: 17%; }
.radar--one { width: 72vw; height: 72vw; right: -12vw; top: -16vw; }
.radar--two { width: 45vw; height: 45vw; right: 2vw; top: 7vw; animation: rotate 48s linear infinite; }
.scan {
  position: absolute;
  inset: -20% 0 auto;
  height: 46%;
  background: linear-gradient(180deg, transparent, rgba(115, 199, 255, 0.035), transparent);
  transform: skewY(-8deg);
  animation: scan 9s ease-in-out infinite;
}
.grid-plane {
  position: absolute;
  width: 90vw;
  height: 60vw;
  right: -15vw;
  bottom: -43vw;
  border-radius: 50%;
  transform: perspective(800px) rotateX(63deg);
  background-image:
    linear-gradient(rgba(115, 199, 255, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(115, 199, 255, 0.07) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: radial-gradient(circle, #000, transparent 70%);
}
.grain {
  position: absolute;
  inset: 0;
  opacity: 0.14;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.25'/%3E%3C/svg%3E");
  mix-blend-mode: screen;
}
@keyframes rotate { to { transform: rotate(360deg); } }
@keyframes scan { 0%, 100% { transform: translateY(-50%) skewY(-8deg); } 50% { transform: translateY(220%) skewY(-8deg); } }

.hero__scene { position: absolute; inset: 0 0 0 34%; z-index: 2; }
#carScene,
.scene-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
#carScene { display: block; cursor: grab; touch-action: none; }
#carScene:active { cursor: grabbing; }
.scene-fallback {
  display: grid;
  place-items: center;
  color: var(--blue);
  background: radial-gradient(circle at 50% 48%, rgba(40, 129, 198, 0.13), transparent 36%);
}
.scene-fallback svg { width: min(90%, 1100px); filter: drop-shadow(0 0 16px rgba(115, 199, 255, 0.42)); opacity: 0.82; }
.scene-label {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 8;
  min-width: 190px;
  padding-left: 52px;
  color: #9eb1c4;
  font: 8px/1.35 var(--mono);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  pointer-events: none;
  transition: opacity 0.3s;
}
.scene-label::before { content: ""; position: absolute; left: 0; top: 11px; width: 40px; height: 1px; background: rgba(115, 199, 255, 0.48); }
.scene-label::after { content: ""; position: absolute; left: -3px; top: 8px; width: 7px; height: 7px; border: 1px solid var(--blue); border-radius: 50%; box-shadow: 0 0 10px rgba(115, 199, 255, 0.55); }
.scene-label span { display: block; color: #61768b; margin-bottom: 5px; }
.scene-label strong { font-weight: 500; color: #c7d8e7; }
.scene-readout { position: absolute; z-index: 8; right: 52px; top: 104px; display: grid; gap: 13px; text-align: right; pointer-events: none; }
.scene-readout div { padding-right: 12px; border-right: 1px solid rgba(115, 199, 255, 0.24); }
.scene-readout span { display: block; color: #5e7185; font: 7px/1 var(--mono); letter-spacing: 0.18em; }
.scene-readout strong { display: block; margin-top: 4px; font: 500 11px/1 var(--mono); letter-spacing: 0.12em; }
.scene-controls {
  position: absolute;
  z-index: 9;
  left: 7%;
  bottom: 116px;
  display: flex;
  gap: 6px;
  padding: 5px;
  border: 1px solid var(--line);
  background: rgba(2, 5, 10, 0.48);
  backdrop-filter: blur(8px);
}
.scene-mode,
.scene-reset {
  padding: 10px 13px;
  border: 1px solid transparent;
  background: transparent;
  color: #708398;
  cursor: pointer;
  font: 800 8px/1 var(--body);
  letter-spacing: 0.17em;
  transition: background 0.25s, color 0.25s, border-color 0.25s;
}
.scene-mode:hover,
.scene-reset:hover { color: #fff; }
.scene-mode.is-active { color: #fff; background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); }
.scene-reset { border-left-color: var(--line); }

.hero__copy {
  position: relative;
  z-index: 12;
  width: min(650px, 41vw);
  padding: clamp(128px, 16vh, 176px) 0 0 var(--page-pad);
}
.eyebrow,
.hero__prefix { margin: 0; font: 800 8px/1.4 var(--body); letter-spacing: 0.25em; text-transform: uppercase; }
.eyebrow { color: #63768b; }
.hero__prefix { margin-top: 40px; color: #b7d7ec; }
.hero h1 {
  margin: 16px 0 0;
  font-family: var(--display);
  font-size: clamp(72px, 8vw, 146px);
  line-height: 0.76;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  font-stretch: condensed;
  font-weight: 800;
}
.hero h1 span { color: #8ba0b4; }
.hero__statement { margin: 30px 0 0; color: #e4edf4; font: 500 clamp(17px, 1.45vw, 23px)/1.35 var(--body); }
.hero__body { max-width: 500px; margin: 16px 0 0; color: #92a3b4; font: 400 clamp(14px, 1.05vw, 17px)/1.75 var(--body); }
.hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 25px; margin-top: 31px; }
.film-trigger {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  min-width: 204px;
  padding: 15px 20px;
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.02);
  cursor: pointer;
  font: 800 9px/1 var(--body);
  letter-spacing: 0.2em;
  transition: transform 0.25s, background 0.25s;
}
.film-trigger:hover { transform: translateY(-2px); background: rgba(255, 255, 255, 0.06); }
.film-trigger__icon { width: 0; height: 0; border-top: 4px solid transparent; border-bottom: 4px solid transparent; border-left: 7px solid #fff; }
