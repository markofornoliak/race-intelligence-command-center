.film-trigger__dot { width: 8px; height: 8px; margin-left: auto; border-radius: 50%; background: var(--red); box-shadow: 0 0 14px rgba(255, 49, 56, 0.8); }
.text-link { color: var(--red); text-decoration: none; font: 800 8px/1.4 var(--body); letter-spacing: 0.14em; transition: color 0.25s; }
.text-link:hover { color: #ff676c; }
.text-link span { margin-left: 6px; }
.hero__telemetry {
  position: absolute;
  z-index: 12;
  left: var(--page-pad);
  right: 70px;
  bottom: 24px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--line);
}
.hero__telemetry div { padding: 14px 24px 0 0; }
.hero__telemetry span,
.hero__telemetry small { display: block; color: #637589; font: 800 7px/1 var(--body); letter-spacing: 0.18em; text-transform: uppercase; }
.hero__telemetry strong { display: block; margin: 7px 0; font: 500 12px/1 var(--mono); letter-spacing: 0.12em; }
.hero__scroll {
  position: absolute;
  z-index: 12;
  right: var(--page-pad);
  bottom: 25px;
  display: none;
  align-items: center;
  gap: 10px;
  color: #607388;
  font: 800 7px/1 var(--body);
  letter-spacing: 0.18em;
}
.hero__scroll span { width: 34px; height: 1px; background: #607388; }

.section-shell { width: min(1640px, 100%); margin: 0 auto; padding-left: var(--page-pad); padding-right: var(--page-pad); }
.section-index { position: relative; z-index: 2; color: #5c7085; font: 800 8px/1 var(--body); letter-spacing: 0.25em; }
.manifesto {
  position: relative;
  padding: 132px 0 118px;
  background: #050b13;
  overflow: hidden;
}
.manifesto::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(115, 199, 255, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(115, 199, 255, 0.045) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: linear-gradient(180deg, #000, transparent 86%);
}
.manifesto__grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.12fr 0.88fr;
  gap: 8vw;
  margin-top: 68px;
  align-items: end;
}
.manifesto__headline > p { margin: 0 0 20px; color: #91a8bb; font: 800 9px/1.5 var(--body); letter-spacing: 0.24em; max-width: 450px; }
.manifesto h2,
.operations h2,
.hdx h2,
.closing h2 { margin: 0; font-family: var(--display); text-transform: uppercase; font-weight: 800; letter-spacing: 0.01em; }
.manifesto h2 { font-size: clamp(72px, 8.8vw, 152px); line-height: 0.76; }
.manifesto h2 span { color: #70859a; }
.manifesto__copy { padding-bottom: 4px; }
.manifesto__copy p { max-width: 630px; margin: 0; color: #8fa1b3; font-size: 17px; line-height: 1.85; }
.manifesto__copy .lead { margin-bottom: 22px; color: #d3dee7; font-size: clamp(20px, 2vw, 29px); line-height: 1.5; }
.signal-line {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 100px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.signal-line::before {
  content: "";
  position: absolute;
  top: 65px;
  left: 10%;
  right: 10%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--line-strong), transparent);
}
.signal-line article { position: relative; min-height: 340px; padding: 26px 34px 34px; border-right: 1px solid var(--line); transition: background 0.3s; }
.signal-line article:last-child { border-right: 0; }
.signal-line article:hover { background: linear-gradient(180deg, rgba(115, 199, 255, 0.035), transparent); }
.signal-line__number { color: #63778d; font: 500 13px/1 var(--mono); letter-spacing: 0.18em; }
.signal-line__icon {
  position: relative;
  width: 72px;
  height: 72px;
  margin: 28px 0 34px;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: radial-gradient(circle, rgba(115, 199, 255, 0.12), transparent 66%);
}
.signal-line__icon::before,
.signal-line__icon::after { content: ""; position: absolute; border-radius: 50%; border: 1px solid rgba(115, 199, 255, 0.17); }
.signal-line__icon::before { inset: 8px; }
.signal-line__icon::after { inset: 18px; }
.signal-line__icon i { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 15px var(--blue); }
.signal-line small { color: #6c8298; font: 800 8px/1 var(--body); letter-spacing: 0.22em; }
.signal-line h3 { margin: 10px 0 12px; max-width: 400px; font-size: clamp(26px, 2.4vw, 40px); font-weight: 500; letter-spacing: -0.02em; }
.signal-line p { max-width: 460px; margin: 0; color: #8597a8; line-height: 1.75; }

.operations {
  position: relative;
  padding: 138px 0 126px;
  overflow: hidden;
  background:
    radial-gradient(circle at 76% 30%, rgba(16, 91, 148, 0.18), transparent 25%),
    linear-gradient(180deg, #030810, #050d17);
}
.operations::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.42;
  background:
    linear-gradient(90deg, transparent 49.9%, rgba(115, 199, 255, 0.035) 50%, transparent 50.1%),
    linear-gradient(transparent 49.9%, rgba(115, 199, 255, 0.035) 50%, transparent 50.1%);
  background-size: 90px 90px;
}
.operations__shell { position: relative; z-index: 2; }
.operations__intro { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 8vw; align-items: end; }
.operations__intro .section-index { grid-column: 1 / -1; }
.operations h2 { margin-top: 44px; font-size: clamp(72px, 8.2vw, 136px); line-height: 0.78; }
.operations h2 span { color: #70859a; }
.operations__intro > p { max-width: 620px; margin: 0 0 7px; color: #9aabbc; font-size: clamp(18px, 1.6vw, 25px); line-height: 1.65; }
.operations__board {
  margin-top: 84px;
  border: 1px solid var(--line-strong);
  background: rgba(3, 9, 16, 0.73);
  box-shadow: 0 40px 100px rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(16px);
}
.board__header { display: flex; justify-content: space-between; gap: 20px; padding: 17px 22px; border-bottom: 1px solid var(--line); color: #71859a; font: 800 8px/1 var(--body); letter-spacing: 0.2em; }
.board__status { display: inline-flex; align-items: center; gap: 9px; color: #8c9dad; }
.board__status i { width: 5px; height: 5px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); }
.board__track { display: grid; grid-template-columns: 1.35fr 0.65fr; min-height: 430px; }
.track-map { position: relative; display: grid; place-items: center; overflow: hidden; border-right: 1px solid var(--line); background: radial-gradient(circle at 48% 50%, rgba(18, 86, 139, 0.15), transparent 47%); }
.track-map::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(115, 199, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(115, 199, 255, 0.035) 1px, transparent 1px);
  background-size: 42px 42px;
}
.track-map svg { position: relative; z-index: 1; width: min(82%, 680px); overflow: visible; }
.track-map path { fill: none; stroke: rgba(115, 199, 255, 0.65); stroke-width: 2; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 8px rgba(115, 199, 255, 0.38)); }
.track-dot { position: absolute; z-index: 2; width: 9px; height: 9px; border: 2px solid var(--blue-bright); border-radius: 50%; box-shadow: 0 0 14px var(--blue); }
.track-dot--1 { left: 20%; top: 54%; }
.track-dot--2 { left: 38%; top: 30%; }
.track-dot--3 { left: 61%; top: 33%; }
.track-dot--4 { left: 74%; top: 62%; }
.track-dot--5 { left: 47%; top: 73%; background: var(--red); border-color: var(--red); box-shadow: 0 0 16px var(--red); }
.track-callout { position: absolute; z-index: 3; left: 48%; top: 73%; margin: 15px 0 0 18px; padding: 12px 16px; border-left: 1px solid var(--red); background: rgba(2, 5, 10, 0.72); }
.track-callout span,
.track-callout small { display: block; color: #6f8397; font: 800 7px/1 var(--body); letter-spacing: 0.18em; }
.track-callout strong { display: block; margin: 6px 0; font: 500 16px/1 var(--mono); }
.track-readout { display: grid; align-content: center; gap: 32px; padding: 44px; }
.track-readout div { display: grid; grid-template-columns: 1fr auto; gap: 9px 16px; }
.track-readout span { color: #64778c; font: 800 8px/1 var(--body); letter-spacing: 0.17em; }
.track-readout strong { font: 500 13px/1 var(--mono); }
.track-readout i { grid-column: 1 / -1; position: relative; height: 2px; background: rgba(255, 255, 255, 0.08); }
.track-readout i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--value); background: linear-gradient(90deg, var(--blue-deep), var(--blue)); box-shadow: 0 0 10px rgba(115, 199, 255, 0.35); }
.board__timeline { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
.board__timeline article { position: relative; min-height: 142px; padding: 20px; border-right: 1px solid var(--line); }
.board__timeline article:last-child { border-right: 0; }
.board__timeline article::before { content: ""; position: absolute; left: 20px; top: -4px; width: 7px; height: 7px; border: 1px solid var(--blue); border-radius: 50%; background: var(--ink); }
.board__timeline article.is-current { background: linear-gradient(180deg, rgba(115, 199, 255, 0.05), transparent); }
.board__timeline article.is-current::before { background: var(--red); border-color: var(--red); box-shadow: 0 0 12px var(--red); }
.board__timeline span { color: #5d7186; font: 500 8px/1 var(--mono); letter-spacing: 0.12em; }
.board__timeline strong { display: block; margin-top: 16px; font: 800 9px/1 var(--body); letter-spacing: 0.18em; }
.board__timeline p { margin: 10px 0 0; color: #8092a4; font-size: 12px; line-height: 1.5; }
.board__timeline em { position: absolute; right: 16px; top: 16px; color: var(--green); font: 800 7px/1 var(--body); letter-spacing: 0.16em; font-style: normal; }
.operations__metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.operations__metrics article { position: relative; min-height: 205px; padding: 26px 24px; border-right: 1px solid var(--line); }
.operations__metrics article:last-child { border-right: 0; }
.operations__metrics span { color: #53677b; font: 500 9px/1 var(--mono); }
.operations__metrics strong { display: block; margin: 32px 0 12px; font: 500 clamp(38px, 4.8vw, 74px)/0.9 var(--mono); letter-spacing: -0.08em; }
.operations__metrics p { max-width: 250px; margin: 0; color: #8394a6; font-size: 12px; line-height: 1.6; }

.hdx {
  position: relative;
  min-height: 980px;
  padding: 144px 0 126px;
  background:
    radial-gradient(circle at 72% 48%, rgba(27, 113, 180, 0.18), transparent 28%),
    linear-gradient(180deg, #050d17 0%, #07111e 100%);
  overflow: hidden;
}
.hdx__field { position: absolute; inset: 0; pointer-events: none; }
.network-orbit { position: absolute; border: 1px solid rgba(115, 199, 255, 0.1); border-radius: 50%; }
.network-orbit::before,
.network-orbit::after { content: ""; position: absolute; border: 1px dashed rgba(115, 199, 255, 0.09); border-radius: inherit; }
.network-orbit::before { inset: 12%; }
.network-orbit::after { inset: 27%; }
.network-orbit--one { width: 800px; height: 800px; right: -80px; top: 55px; animation: rotate 70s linear infinite reverse; }
.network-orbit--two { width: 500px; height: 500px; right: 90px; top: 205px; animation: rotate 45s linear infinite; }
.network-core { position: absolute; right: 257px; top: 410px; width: 168px; height: 168px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; box-shadow: 0 0 80px rgba(20, 116, 183, 0.15); }
.network-core::before { content: ""; position: absolute; inset: 18px; border: 1px solid rgba(115, 199, 255, 0.17); border-radius: 50%; }
.network-core span { color: #acc8db; text-align: center; font: 800 8px/1.5 var(--body); letter-spacing: 0.18em; }
.network-node { position: absolute; display: flex; align-items: center; gap: 12px; color: #70859a; font: 800 7px/1 var(--body); letter-spacing: 0.18em; }
.network-node i { width: 12px; height: 12px; border: 1px solid var(--blue); border-radius: 50%; box-shadow: 0 0 12px rgba(115, 199, 255, 0.5); }
.network-node::after { content: ""; position: absolute; height: 1px; transform-origin: left center; background: linear-gradient(90deg, rgba(115, 199, 255, 0.55), transparent); }
.network-node--garage { right: 540px; top: 267px; }
.network-node--garage::after { left: 10px; top: 7px; width: 215px; transform: rotate(31deg); }
.network-node--factory { right: 90px; top: 260px; }
.network-node--factory::after { left: -180px; top: 70px; width: 210px; transform: rotate(-29deg); }
.network-node--specialist { right: 92px; top: 708px; }
.network-node--specialist::after { left: -185px; top: -82px; width: 220px; transform: rotate(27deg); }
.hdx__shell { position: relative; z-index: 2; }
.hdx__content { width: min(760px, 54%); }
.hdx h2 { margin-top: 56px; font-size: clamp(76px, 8.2vw, 138px); line-height: 0.78; }
.hdx h2 span { color: #7c92a7; }
