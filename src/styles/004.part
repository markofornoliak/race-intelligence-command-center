/* RI–05 visual refinement layer */
:root {
  --blue: #63d7ff;
  --blue-bright: #d7f6ff;
  --blue-deep: #0875b8;
  --red: #ff2638;
  --line: rgba(111, 213, 255, 0.14);
  --line-strong: rgba(111, 213, 255, 0.38);
}

body {
  background:
    radial-gradient(circle at 70% 0%, rgba(10, 91, 147, 0.08), transparent 28%),
    #010408;
}

.topline {
  height: 80px;
  background: linear-gradient(180deg, rgba(1, 4, 8, 0.52), transparent);
}
.topline::before {
  content: "";
  position: absolute;
  left: var(--page-pad);
  right: var(--page-pad);
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99, 215, 255, 0.2), transparent);
  opacity: 0.8;
}
.topline.is-scrolled {
  background: rgba(1, 4, 8, 0.88);
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
}

.identity__sigil {
  box-shadow:
    inset 0 0 14px rgba(99, 215, 255, 0.08),
    0 0 20px rgba(99, 215, 255, 0.09);
}

.hero {
  min-height: max(100svh, 780px);
  isolation: isolate;
  background:
    radial-gradient(ellipse at 74% 42%, rgba(14, 103, 163, 0.28), transparent 31%),
    radial-gradient(ellipse at 55% 95%, rgba(7, 34, 56, 0.5), transparent 45%),
    linear-gradient(180deg, #010408 0%, #020811 58%, #030a12 100%);
}
.hero::before {
  content: "";
  position: absolute;
  z-index: 1;
  inset: 92px 24px 92px 24px;
  border: 1px solid rgba(114, 215, 255, 0.055);
  clip-path: polygon(0 0, 31% 0, 31% 1px, 69% 1px, 69% 0, 100% 0, 100% 100%, 72% 100%, 72% calc(100% - 1px), 28% calc(100% - 1px), 28% 100%, 0 100%);
  pointer-events: none;
}
.hero::after {
  height: 27%;
  background:
    linear-gradient(180deg, transparent, rgba(1, 4, 8, 0.92)),
    linear-gradient(90deg, rgba(1, 4, 8, 0.85), transparent 22%, transparent 78%, rgba(1, 4, 8, 0.55));
}
.hero__atmosphere::after {
  content: "";
  position: absolute;
  width: 38vw;
  height: 38vw;
  right: 7vw;
  top: 12vh;
  border-radius: 50%;
  background:
    repeating-radial-gradient(circle, rgba(99, 215, 255, 0.085) 0 1px, transparent 1px 62px);
  mask-image: radial-gradient(circle, #000 0 38%, transparent 72%);
  opacity: 0.36;
  animation: rotate 80s linear infinite reverse;
}

.hero__scene {
  inset: 58px -1.5vw 0 27%;
  z-index: 3;
}
.hero__scene::before {
  content: "RI–05 / DIGITAL TWIN";
  position: absolute;
  z-index: 9;
  top: 74px;
  left: 7.5%;
  color: rgba(170, 221, 245, 0.46);
  font: 700 7px/1 var(--mono);
  letter-spacing: 0.22em;
  pointer-events: none;
}
.hero__scene::after {
  content: "";
  position: absolute;
  z-index: 7;
  inset: 8.5% 4.5% 13%;
  border: 1px solid rgba(99, 215, 255, 0.07);
  background:
    linear-gradient(90deg, rgba(99, 215, 255, 0.18), transparent 7%) top left / 120px 1px no-repeat,
    linear-gradient(180deg, rgba(99, 215, 255, 0.18), transparent 7%) top left / 1px 120px no-repeat,
    linear-gradient(-90deg, rgba(99, 215, 255, 0.13), transparent 7%) bottom right / 120px 1px no-repeat,
    linear-gradient(0deg, rgba(99, 215, 255, 0.13), transparent 7%) bottom right / 1px 120px no-repeat;
  clip-path: polygon(0 0, 39% 0, 39% 1px, 61% 1px, 61% 0, 100% 0, 100% 100%, 0 100%);
  pointer-events: none;
}
#carScene {
  filter:
    saturate(1.14)
    contrast(1.04)
    drop-shadow(0 22px 44px rgba(0, 0, 0, 0.42));
}

.scene-readout {
  top: 88px;
  right: 5.5%;
  gap: 0;
  min-width: 168px;
  padding: 13px 15px;
  border: 1px solid rgba(99, 215, 255, 0.16);
  background:
    linear-gradient(135deg, rgba(10, 35, 53, 0.58), rgba(2, 8, 14, 0.3)),
    rgba(2, 7, 12, 0.42);
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.035),
    0 20px 60px rgba(0, 0, 0, 0.26);
  backdrop-filter: blur(15px) saturate(1.25);
  text-align: left;
}
.scene-readout::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 14px;
  width: 2px;
  height: 28px;
  background: var(--red);
  box-shadow: 0 0 14px rgba(255, 38, 56, 0.65);
}
.scene-readout div {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  gap: 16px;
  padding: 8px 0;
  border-right: 0;
  border-bottom: 1px solid rgba(99, 215, 255, 0.08);
}
.scene-readout div:last-child { border-bottom: 0; }
.scene-readout span { font-size: 6px; }
.scene-readout strong { margin: 0; font-size: 9px; color: #dff7ff; }

.scene-label {
  min-width: 218px;
  padding: 10px 12px 10px 54px;
  border: 1px solid rgba(99, 215, 255, 0.08);
  background: linear-gradient(90deg, rgba(2, 10, 17, 0.78), rgba(2, 10, 17, 0.08));
  backdrop-filter: blur(8px);
}
.scene-label::before { left: 12px; width: 30px; }
.scene-label::after { left: 7px; }
.scene-label strong {
  color: #e0f5ff;
  text-shadow: 0 0 14px rgba(99, 215, 255, 0.2);
}

.scene-controls {
  left: 8%;
  bottom: 106px;
  gap: 3px;
  padding: 4px;
  border-color: rgba(99, 215, 255, 0.2);
  border-radius: 3px;
  background:
    linear-gradient(180deg, rgba(13, 35, 51, 0.78), rgba(2, 8, 14, 0.72));
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.04),
    0 22px 70px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px) saturate(1.3);
}
.scene-mode,
.scene-reset {
  position: relative;
  min-height: 38px;
  padding: 0 15px;
  border-radius: 2px;
  overflow: hidden;
}
.scene-mode::before {
  content: "";
  position: absolute;
  inset: auto 10px 0;
  height: 1px;
  background: var(--blue);
  transform: scaleX(0);
  transition: transform 0.28s var(--ease);
}
.scene-mode:hover,
.scene-reset:hover {
  background: rgba(99, 215, 255, 0.055);
}
.scene-mode.is-active {
  color: #e8f9ff;
  border-color: rgba(99, 215, 255, 0.24);
  background:
    linear-gradient(180deg, rgba(99, 215, 255, 0.13), rgba(99, 215, 255, 0.025));
  box-shadow: inset 0 0 20px rgba(99, 215, 255, 0.045);
}
.scene-mode.is-active::before { transform: scaleX(1); }
.scene-reset {
  margin-left: 6px;
  border-left: 1px solid rgba(99, 215, 255, 0.13);
}

.hero__copy {
  width: min(570px, 38vw);
  padding-top: clamp(124px, 15.5vh, 170px);
}
.hero__copy::before {
  content: "";
  position: absolute;
  left: var(--page-pad);
  top: 104px;
  width: 68px;
  height: 2px;
  background:
    linear-gradient(90deg, var(--red) 0 18px, transparent 18px 24px, rgba(99, 215, 255, 0.42) 24px);
  box-shadow: -1px 0 14px rgba(255, 38, 56, 0.42);
}
.hero__copy .eyebrow {
  padding-left: 1px;
  color: #6e879c;
}
.hero__prefix {
  margin-top: clamp(30px, 5vh, 52px);
  color: #c7e5f4;
}
.hero h1 {
  margin-top: 13px;
  font-size: clamp(70px, 7.5vw, 138px);
  line-height: 0.74;
  letter-spacing: -0.018em;
  text-shadow:
    0 0 36px rgba(99, 215, 255, 0.045),
    0 20px 90px rgba(0, 0, 0, 0.55);
}
.hero h1 span {
  color: #758da0;
  -webkit-text-stroke: 1px rgba(199, 231, 245, 0.06);
}
.hero__statement {
  max-width: 520px;
  margin-top: 28px;
  font-size: clamp(17px, 1.28vw, 22px);
}
.hero__body {
  max-width: 470px;
  color: #879cad;
}
.film-trigger {
  min-width: 206px;
  border-color: rgba(224, 246, 255, 0.7);
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.045), transparent),
    rgba(2, 8, 14, 0.3);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
}
.film-trigger:hover {
  background: rgba(99, 215, 255, 0.09);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
}

.hero__telemetry {
  left: var(--page-pad);
  right: 6.3vw;
  bottom: 22px;
  gap: 0;
  padding: 0 16px 11px;
  border: 1px solid rgba(99, 215, 255, 0.1);
  border-top-color: rgba(99, 215, 255, 0.28);
  background:
    linear-gradient(90deg, rgba(7, 24, 37, 0.62), rgba(2, 8, 14, 0.42)),
    rgba(2, 7, 12, 0.36);
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.025),
    0 24px 64px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(14px);
}
.hero__telemetry::before {
  content: "LIVE ENGINEERING STATE";
  position: absolute;
  right: 14px;
  top: -19px;
  color: rgba(116, 145, 165, 0.7);
  font: 700 6px/1 var(--mono);
  letter-spacing: 0.2em;
}
.hero__telemetry div {
  position: relative;
  padding: 17px 20px 4px;
  border-right: 1px solid rgba(99, 215, 255, 0.08);
}
.hero__telemetry div:last-child { border-right: 0; }
.hero__telemetry div::after {
  content: "";
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: -5px;
  height: 1px;
  background: linear-gradient(90deg, var(--blue-deep), transparent);
  opacity: 0.45;
}

.manifesto,
.operations,
.hdx {
  isolation: isolate;
}
.manifesto {
  background:
    radial-gradient(circle at 14% 14%, rgba(14, 84, 133, 0.13), transparent 25%),
    linear-gradient(180deg, #030910, #050d16);
}
.manifesto::after {
  content: "";
  position: absolute;
  z-index: 0;
  width: 40vw;
  height: 40vw;
  right: -18vw;
  top: 8%;
  border: 1px solid rgba(99, 215, 255, 0.075);
  border-radius: 50%;
  box-shadow:
    0 0 0 5vw rgba(99, 215, 255, 0.018),
    0 0 0 10vw rgba(99, 215, 255, 0.012);
}

.signal-line {
  border-color: rgba(99, 215, 255, 0.16);
  background:
    linear-gradient(180deg, rgba(13, 37, 55, 0.25), rgba(2, 8, 14, 0.18));
  box-shadow: 0 40px 110px rgba(0, 0, 0, 0.25);
}
.signal-line article {
  overflow: hidden;
}
.signal-line article::after {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  right: -90px;
  bottom: -100px;
  border: 1px solid rgba(99, 215, 255, 0.08);
  border-radius: 50%;
  transition: transform 0.5s var(--ease), opacity 0.5s;
}
.signal-line article:hover::after {
  transform: scale(1.35);
  opacity: 0.8;
}
.signal-line__icon {
  box-shadow:
    inset 0 0 24px rgba(99, 215, 255, 0.08),
    0 0 36px rgba(99, 215, 255, 0.04);
}

.operations {
  background:
    radial-gradient(circle at 72% 20%, rgba(18, 102, 161, 0.21), transparent 28%),
    radial-gradient(circle at 20% 78%, rgba(5, 46, 77, 0.24), transparent 32%),
    linear-gradient(180deg, #020811, #040c15);
}
.operations__board {
  position: relative;
  border-color: rgba(99, 215, 255, 0.24);
  background:
    linear-gradient(145deg, rgba(8, 27, 42, 0.78), rgba(2, 8, 14, 0.76));
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.03),
    0 48px 140px rgba(0, 0, 0, 0.48);
}
.operations__board::before {
  content: "";
  position: absolute;
  inset: -1px;
  pointer-events: none;
  background:
    linear-gradient(90deg, var(--red), transparent 120px) top left / 120px 1px no-repeat,
    linear-gradient(180deg, var(--red), transparent 70px) top left / 1px 70px no-repeat,
    linear-gradient(-90deg, rgba(99, 215, 255, 0.48), transparent 160px) bottom right / 160px 1px no-repeat,
    linear-gradient(0deg, rgba(99, 215, 255, 0.48), transparent 90px) bottom right / 1px 90px no-repeat;
}
.track-map {
  background:
    radial-gradient(circle at 48% 50%, rgba(25, 116, 177, 0.2), transparent 43%),
    linear-gradient(135deg, rgba(7, 25, 39, 0.72), rgba(2, 8, 14, 0.35));
}
.track-map svg {
  filter:
    drop-shadow(0 0 12px rgba(99, 215, 255, 0.18))
    drop-shadow(0 24px 54px rgba(0, 0, 0, 0.48));
}
.operations__metrics article {
  background: linear-gradient(180deg, rgba(99, 215, 255, 0.018), transparent);
  transition: background 0.3s, transform 0.3s var(--ease);
}
.operations__metrics article:hover {
  background: linear-gradient(180deg, rgba(99, 215, 255, 0.065), transparent);
  transform: translateY(-3px);
}
.operations__metrics strong {
  color: #dff7ff;
  text-shadow: 0 0 28px rgba(99, 215, 255, 0.1);
}

.hdx {
  background:
    radial-gradient(circle at 73% 46%, rgba(22, 115, 181, 0.24), transparent 27%),
    radial-gradient(circle at 34% 80%, rgba(5, 54, 88, 0.28), transparent 31%),
    linear-gradient(180deg, #040c15 0%, #061321 100%);
}
.hdx__principles article {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(99, 215, 255, 0.018), transparent);
}
.hdx__principles article::after {
  content: "";
  position: absolute;
  inset: auto 22px 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99, 215, 255, 0.4), transparent);
  transform: scaleX(0);
  transition: transform 0.35s var(--ease);
}
.hdx__principles article:hover::after { transform: scaleX(1); }

.film {
  border-color: rgba(99, 215, 255, 0.28);
  background:
    radial-gradient(circle at 72% 38%, rgba(18, 108, 171, 0.25), transparent 28%),
    linear-gradient(145deg, rgba(5, 19, 31, 0.98), rgba(1, 5, 9, 0.98));
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.04),
    0 80px 180px rgba(0, 0, 0, 0.75);
}

@media (max-width: 1180px) {
  .hero__scene {
    left: 23%;
    opacity: 0.94;
  }
  .hero__copy {
    width: min(560px, 48vw);
  }
  .scene-readout {
    right: 3%;
  }
}

@media (max-width: 900px) {
  .hero {
    min-height: 980px;
  }
  .hero__scene {
    inset: 260px -13% 96px -4%;
  }
  .hero__scene::before {
    top: 34px;
    left: 8%;
  }
  .hero__scene::after {
    inset: 3% 7% 16%;
  }
  .hero__copy {
    width: min(680px, calc(100% - 48px));
    padding-top: 112px;
  }
  .hero__copy::before {
    top: 92px;
  }
  .hero h1 {
    font-size: clamp(68px, 12vw, 116px);
  }
  .scene-readout {
    top: 32px;
    right: 8%;
  }
  .scene-controls {
    left: 8%;
    bottom: 52px;
  }
  .hero__telemetry {
    left: 24px;
    right: 24px;
    bottom: 18px;
  }
}

@media (max-width: 760px) {
  .hero {
    min-height: 940px;
  }
  .hero::before {
    inset: 74px 10px 112px;
  }
  .hero__scene {
    inset: 318px -42% 122px -28%;
  }
  .hero__scene::before,
  .hero__scene::after,
  .scene-label,
  .scene-readout {
    display: none;
  }
  .hero__copy {
    width: calc(100% - 36px);
    padding-top: 102px;
  }
  .hero__copy::before {
    left: 18px;
    top: 84px;
  }
  .hero h1 {
    font-size: clamp(58px, 18.5vw, 88px);
    line-height: 0.77;
  }
  .hero__statement {
    margin-top: 21px;
  }
  .hero__body {
    max-width: 92%;
    font-size: 13px;
    line-height: 1.65;
  }
  .hero__actions {
    margin-top: 24px;
  }
  .scene-controls {
    left: 50%;
    bottom: 38px;
    width: max-content;
    max-width: calc(100vw - 28px);
    transform: translateX(-50%);
  }
  .scene-mode,
  .scene-reset {
    min-height: 34px;
    padding: 0 10px;
    font-size: 6px;
    letter-spacing: 0.13em;
  }
  .hero__telemetry {
    grid-template-columns: repeat(2, 1fr);
    padding: 0 6px 8px;
  }
  .hero__telemetry div {
    padding: 12px 10px 3px;
  }
  .hero__telemetry div:nth-child(2) {
    border-right: 0;
  }
  .hero__telemetry div:nth-child(-n + 2) {
    border-bottom: 1px solid rgba(99, 215, 255, 0.08);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__atmosphere::after {
    animation: none;
  }
  .signal-line article::after,
  .operations__metrics article,
  .hdx__principles article::after {
    transition: none;
  }
}
